---
interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;

const projects = lang === 'zh'
  ? [
      {
        title: 'My Heathrow',
        description: '將多項機場服務整合至統一的數位平台 — 提升旅客體驗並推動會員忠誠度參與。',
        tags: ['企業', '使用者研究', '設計系統'],
        href: '/zh/work/my-heathrow',
        image: '/images/work/my-heathrow/hero.jpg',
        imageAlt: 'My Heathrow 機場服務平台的統一儀表板',
        surface: 'pink',
        category: '企業',
        impact: '3 → 1',
        impactLabel: '三項服務整合為單一登入',
      },
      {
        title: 'Kinship',
        description: '連結照顧者與指引、資源及社群的照護支援平台 — 讓支援更容易取得。',
        tags: ['服務', '無障礙', '行動裝置'],
        href: '/zh/work/kinship',
        image: '/images/work/kinship/hero.jpg',
        imageAlt: 'Kinship Connect — 為親屬照顧者設計的引導式造句表單',
        surface: 'orange',
        imageBg: '#FEEECA',
        category: '服務',
        impact: '20',
        impactLabel: '形塑設計的照顧者訪談',
      },
      {
        title: 'Cornershop',
        description: '橫跨數位與實體接觸點的全通路零售體驗，並為店員提供營運儀表板。',
        tags: ['零售', '電商', '儀表板'],
        href: '/zh/work/cornershop',
        image: '/images/work/cornershop/hero.jpg',
        imageAlt: 'Cornershop 零售營運儀表板',
        surface: 'blue',
        category: '零售',
        impact: '全通路',
        impactLabel: '串連門市與網站的藍圖',
      },
    ]
  : [
      {
        title: 'My Heathrow',
        description: 'Consolidating multiple airport services into a unified digital platform — improving passenger experience and driving loyalty engagement.',
        tags: ['Enterprise', 'UX Research', 'Design System'],
        href: '/work/my-heathrow',
        image: '/images/work/my-heathrow/hero.jpg',
        imageAlt: 'My Heathrow airport services platform showing the unified dashboard',
        surface: 'pink',
        category: 'Enterprise',
        impact: '3 → 1',
        impactLabel: 'Services unified under one login',
      },
      {
        title: 'Kinship',
        description: 'A care support platform that connects carers with guidance, resources, and community — making support more accessible.',
        tags: ['Service', 'Accessibility', 'Mobile'],
        href: '/work/kinship',
        image: '/images/work/kinship/hero.jpg',
        imageAlt: 'Kinship Connect — a guided sentence-builder form for kinship carers',
        surface: 'orange',
        imageBg: '#FEEECA',
        category: 'Service',
        impact: '20',
        impactLabel: 'Carer interviews shaping the design',
      },
      {
        title: 'Cornershop',
        description: 'An omnichannel retail experience bridging digital and physical touchpoints, with operations dashboards for staff.',
        tags: ['Retail', 'E-commerce', 'Dashboard'],
        href: '/work/cornershop',
        image: '/images/work/cornershop/hero.jpg',
        imageAlt: 'Cornershop retail operations dashboard',
        surface: 'blue',
        category: 'Retail',
        impact: 'Omnichannel',
        impactLabel: 'Blueprint connecting store + web',
      },
    ];

const ui = lang === 'zh'
  ? { eyebrow: '精選作品', heading: '近期案例研究', project: '專案' }
  : { eyebrow: 'Selected work', heading: 'Recent case studies', project: 'Project' };

const surfaceMap: Record<string, string> = { pink: 'bg-pink', orange: 'bg-orange', yellow: 'bg-yellow', blue: 'bg-blue' };
---

<section id="work" class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-6">
    {/* Header — title only, no supporting copy */}
    <div class="reveal mb-12 md:mb-16">
      <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        {ui.eyebrow}
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-semibold text-text-primary leading-tight">
        {ui.heading}
      </h2>
    </div>

    {/* Vertical stack of horizontal cards */}
    <div class="flex flex-col gap-6 md:gap-8">
      {projects.map((p, i) => {
        const surfaceClass = surfaceMap[p.surface];
        const number = String(i + 1).padStart(2, '0');
        const reversed = i % 2 === 1;
        return (
          <a
            href={p.href}
            class="reveal group relative block rounded-2xl border border-border bg-surface overflow-hidden transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class={`grid grid-cols-1 md:grid-cols-12 gap-0 ${reversed ? 'md:[&>*:first-child]:order-2' : ''}`}>
              {/* Image side — palette backdrop */}
              <div class="md:col-span-7 p-5 md:p-6">
                <div
                  class={`relative ${p.imageBg ? '' : surfaceClass} aspect-[16/10] md:aspect-[16/11] overflow-hidden rounded-xl`}
                  style={p.imageBg ? `background-color: ${p.imageBg}` : undefined}
                >
                  <img src={p.image} alt={p.imageAlt} loading={i === 0 ? 'eager' : 'lazy'} class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />
                  {/* Number badge top-left of image */}
                  <span class="absolute top-4 left-4 inline-flex items-center justify-center min-w-9 h-9 px-3 rounded-full bg-surface/95 backdrop-blur text-xs font-semibold text-text-primary shadow-sm">
                    {number}
                  </span>
                </div>
              </div>

              {/* Content side */}
              <div class="md:col-span-5 p-5 md:p-8 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-5">
                    <span class={`inline-flex items-center px-3 h-7 rounded-full text-[10px] font-semibold tracking-[0.18em] uppercase text-text-primary ${surfaceClass}`}>
                      {p.category}
                    </span>
                    <span class="text-[11px] font-semibold tracking-[0.2em] uppercase text-text-tertiary">
                      {ui.project} {number}
                    </span>
                  </div>

                  <h3 class="text-2xl md:text-3xl font-semibold text-text-primary mb-3 group-hover:text-accent transition-colors leading-tight">
                    {p.title}
                  </h3>
                  <p class="text-sm md:text-base text-text-secondary leading-relaxed mb-6 line-clamp-3">{p.description}</p>
                </div>

                {/* Impact stat sits alongside tags + arrow chip */}
                <div class="pt-5 border-t border-border">
                  <div class="flex items-end justify-between gap-4 mb-4">
                    <div>
                      <p class="text-2xl md:text-3xl font-semibold text-text-primary leading-none mb-1.5 transition-transform duration-500 group-hover:-translate-y-0.5">
                        {p.impact}
                      </p>
                      <p class="text-[10px] md:text-[11px] font-medium text-text-tertiary tracking-[0.14em] uppercase">{p.impactLabel}</p>
                    </div>
                    <span class="inline-flex items-center justify-center w-9 h-9 rounded-full text-text-primary transition-all duration-300 group-hover:bg-accent group-hover:text-surface group-hover:rotate-45 shrink-0">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </span>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {p.tags.map((tag) => (
                      <span class="text-[10px] font-medium text-text-secondary border border-border px-2 py-0.5 rounded-full">{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
