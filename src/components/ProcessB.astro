---
const steps = [
  {
    number: '01',
    title: 'Define',
    description: 'Understand the problem space, stakeholder goals, and user needs through research and analysis.',
    surface: 'bg-pink',
    tags: ['Stakeholder interviews', 'Problem framing', 'Success metrics'],
    visual: 'define',
  },
  {
    number: '02',
    title: 'Discover',
    description: 'Explore opportunities through user research, competitive analysis, and collaborative workshops.',
    surface: 'bg-orange',
    tags: ['User interviews', 'Journey maps', 'Synthesis'],
    visual: 'discover',
  },
  {
    number: '03',
    title: 'Develop',
    description: 'Create solutions through iterative prototyping, testing, and design system thinking.',
    surface: 'bg-yellow',
    tags: ['Wireframes', 'Hi-fi designs', 'Usability testing', 'Vibe coding'],
    visual: 'develop',
  },
  {
    number: '04',
    title: 'Deliver',
    description: 'Ship polished designs with clear documentation, handoff specs, and measurable outcomes.',
    surface: 'bg-blue',
    tags: ['Design system', 'Dev handoff', 'QA review'],
    visual: 'deliver',
  },
];
---

<section id="process" class="py-20 md:py-28 bg-gradient-value relative overflow-visible">
  {/* Bridge blob — peeks up into the section above for soft transition */}
  <div
    class="absolute -top-40 left-[12%] w-96 h-96 rounded-full bg-blue opacity-30 blur-2xl pointer-events-none"
    aria-hidden="true"
  ></div>

  {/* Floating decorative shapes — softer than Hero so How I work reads lighter */}
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div data-float data-float-speed="0.025" class="absolute top-[12%] left-[10%] w-24 h-24 rounded-full bg-pink opacity-20 blur-2xl"></div>
    <div data-float data-float-speed="-0.03" class="absolute top-[40%] left-[4%] w-32 h-32 rounded-full bg-blue opacity-30 blur-2xl"></div>
    <div data-float data-float-speed="0.04" class="absolute top-[20%] right-[8%] w-32 h-32 rounded-full bg-yellow opacity-30 blur-2xl"></div>
    <div data-float data-float-speed="-0.02" class="absolute top-[55%] right-[14%] w-28 h-28 rounded-full bg-orange opacity-25 blur-2xl"></div>
  </div>

  <div class="max-w-5xl mx-auto px-6 relative">
    <div class="reveal max-w-2xl mb-12 md:mb-16">
      <p class="text-xs font-medium text-accent uppercase tracking-[0.18em] mb-3 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        Process
      </p>
      <h2 class="text-3xl md:text-4xl font-semibold text-text-primary mb-4">
        How I work
      </h2>
      <p class="text-text-secondary text-lg">
        A structured yet flexible approach — auto-stepping from define to deliver.
      </p>
    </div>

    {/* Linear progress stepper */}
    <div class="reveal relative mb-10 md:mb-12" data-process-stepper>
      {/* Track background */}
      <div class="absolute top-3.5 md:top-4 left-[12.5%] right-[12.5%] h-[2px] bg-border rounded-full"></div>
      {/* Progress fill */}
      <div
        class="absolute top-3.5 md:top-4 left-[12.5%] h-[2px] bg-accent rounded-full transition-all duration-700 ease-out"
        data-process-progress
        style="width: 0%;"
      ></div>

      <div class="grid grid-cols-4 relative">
        {steps.map((step, i) => (
          <button
            type="button"
            data-process-dot
            data-index={i}
            data-active={i === 0 ? 'true' : 'false'}
            aria-label={`Go to step ${step.number} ${step.title}`}
            class="dot-btn group flex flex-col items-center gap-2 focus:outline-none"
          >
            <span class="dot-circle relative w-7 h-7 md:w-8 md:h-8 rounded-full bg-surface border-2 border-border flex items-center justify-center transition-all duration-300 shadow-sm">
              <span class="dot-inner w-2 h-2 rounded-full bg-text-tertiary transition-all duration-300"></span>
              <span class="dot-pulse absolute inset-0 rounded-full ring-2 ring-accent opacity-0 transition-opacity duration-300"></span>
            </span>
            <span class="dot-label text-xs md:text-sm font-medium text-text-tertiary transition-colors duration-300">
              {step.number} · {step.title}
            </span>
          </button>
        ))}
      </div>
    </div>

    {/* 4-up grid — all cards visible, active one highlighted */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 max-w-5xl mx-auto" data-process-cards>
      {steps.map((step, i) => (
        <article
          data-process-card
          data-index={i}
          data-active={i === 0 ? 'true' : 'false'}
          tabindex="0"
          aria-label={`Step ${step.number}: ${step.title}`}
          class={`process-card group h-full rounded-2xl border border-border bg-surface/85 backdrop-blur-md p-5 flex flex-col cursor-pointer transition-all duration-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2`}
        >
          {/* Inline icon + step number */}
          <div class="flex items-center justify-between mb-3">
            <span class={`inline-flex items-center justify-center w-9 h-9 rounded-lg ${step.surface} border border-border text-text-primary`}>
              {step.visual === 'define' && (
                <svg class="w-4.5 h-4.5" style="width:18px;height:18px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3.5" y="5" width="17" height="14" rx="2"/>
                  <line x1="6.5" y1="9" x2="15.5" y2="9"/>
                  <line x1="6.5" y1="12" x2="17.5" y2="12"/>
                  <line x1="6.5" y1="15" x2="13" y2="15"/>
                  <circle cx="18" cy="6.5" r="1.4" fill="currentColor"/>
                </svg>
              )}
              {step.visual === 'discover' && (
                <svg class="w-4.5 h-4.5" style="width:18px;height:18px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6"/>
                  <line x1="15" y1="15" x2="20" y2="20"/>
                  <circle cx="9" cy="9.5" r="0.7" fill="currentColor"/>
                  <circle cx="12" cy="9.5" r="0.7" fill="currentColor"/>
                  <path d="M8.5 12 Q10.5 13.4 12.5 12" />
                </svg>
              )}
              {step.visual === 'develop' && (
                <svg class="w-4.5 h-4.5" style="width:18px;height:18px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3.5" y="4" width="10" height="14" rx="1.5"/>
                  <rect x="11" y="7" width="9.5" height="13" rx="1.5" fill="var(--color-surface)"/>
                  <line x1="13" y1="11" x2="18.5" y2="11"/>
                  <line x1="13" y1="13.5" x2="17" y2="13.5"/>
                </svg>
              )}
              {step.visual === 'deliver' && (
                <svg class="w-4.5 h-4.5" style="width:18px;height:18px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12 L10 17 L19.5 7"/>
                </svg>
              )}
            </span>
            <span class="text-[11px] font-semibold text-text-tertiary tracking-[0.2em]">{step.number}</span>
          </div>

          <h3 class="text-lg font-semibold text-text-primary mb-2">{step.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed mb-4 flex-1">{step.description}</p>

          <ul class="space-y-1.5">
            {step.tags.map((tag) => (
              <li class="text-xs text-text-primary flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-accent ring-1 ring-text-primary/10 shrink-0"></span>
                {tag}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const stepper = document.querySelector<HTMLElement>('[data-process-stepper]');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-process-dot]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-process-card]'));
  const progressFill = document.querySelector<HTMLElement>('[data-process-progress]');
  const cardsWrap = document.querySelector<HTMLElement>('[data-process-cards]');
  const section = document.querySelector<HTMLElement>('#process');

  if (stepper && dots.length && cards.length) {
    let active = 0;
    const total = cards.length;
    const intervalMs = 2200;
    let timer: number | null = null;
    let paused = false;
    let visible = false;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function render() {
      dots.forEach((d, i) => {
        const isActive = i === active;
        const isDone = i < active;
        d.dataset.active = isActive ? 'true' : 'false';
        d.dataset.done = isDone ? 'true' : 'false';
      });
      cards.forEach((c, i) => { c.dataset.active = i === active ? 'true' : 'false'; });
      const pct = total > 1 ? (active / (total - 1)) * 100 : 0;
      if (progressFill) progressFill.style.width = `${pct}%`;
    }

    function tick() {
      active = (active + 1) % total;
      render();
    }

    function start() {
      if (timer || paused || !visible || reduceMotion) return;
      timer = window.setInterval(tick, intervalMs);
    }
    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    // Pause on hover / focus within the section
    section?.addEventListener('mouseenter', () => { paused = true; stop(); });
    section?.addEventListener('mouseleave', () => { paused = false; start(); });
    section?.addEventListener('focusin', () => { paused = true; stop(); });
    section?.addEventListener('focusout', (e) => {
      if (!section.contains(e.relatedTarget as Node)) { paused = false; start(); }
    });

    // Click a dot or a card to jump
    dots.forEach((d, i) => d.addEventListener('click', () => { active = i; render(); stop(); start(); }));
    cards.forEach((c, i) => c.addEventListener('click', () => { active = i; render(); stop(); start(); }));

    // Only auto-advance when the section is on screen
    if ('IntersectionObserver' in window && section) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          visible = entry.isIntersecting;
          if (visible) start(); else stop();
        });
      }, { threshold: 0.25 });
      io.observe(section);
    } else {
      visible = true;
      start();
    }

    render();
  }
</script>

<style>
  /* Stepper dot states */
  .dot-btn[data-active='true'] .dot-circle {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.1);
  }
  .dot-btn[data-active='true'] .dot-inner {
    background-color: var(--color-surface);
    transform: scale(1.2);
  }
  .dot-btn[data-active='true'] .dot-pulse {
    opacity: 1;
    animation: dot-pulse 2.4s ease-out infinite;
  }
  .dot-btn[data-active='true'] .dot-label {
    color: var(--color-text-primary);
    font-weight: 600;
  }
  .dot-btn[data-done='true'] .dot-circle {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .dot-btn[data-done='true'] .dot-inner {
    background-color: var(--color-surface);
  }
  .dot-btn[data-done='true'] .dot-label {
    color: var(--color-text-secondary);
  }
  .dot-btn:hover .dot-circle,
  .dot-btn:focus-visible .dot-circle {
    border-color: var(--color-text-primary);
  }

  @keyframes dot-pulse {
    0%   { transform: scale(1); opacity: 0.6; }
    70%  { transform: scale(1.6); opacity: 0; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  /* Card active emphasis */
  .process-card {
    transform: translateY(0) scale(0.98);
    will-change: transform, background-color, box-shadow;
  }
  .process-card[data-active='true'] {
    background-color: var(--color-surface);
    transform: translateY(-6px) scale(1);
    box-shadow: 0 20px 40px -16px rgba(0, 0, 0, 0.12);
  }
  .process-card:hover,
  .process-card:focus-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .process-card,
    .dot-circle,
    .dot-inner,
    .dot-pulse {
      transition: none !important;
      animation: none !important;
    }
    .process-card { opacity: 1; transform: none; }
  }
</style>
