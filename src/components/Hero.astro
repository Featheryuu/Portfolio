<section class="relative overflow-hidden bg-gradient-soft min-h-[92vh] flex items-center">
  {/* Floating decorative shapes */}
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div data-float data-float-speed="0.02" class="absolute top-[18%] right-[12%] w-40 h-40 rounded-full bg-orange opacity-40 blur-2xl"></div>
    <div data-float data-float-speed="-0.03" class="absolute top-[55%] right-[6%] w-24 h-24 rounded-full bg-yellow opacity-50 blur-xl"></div>
    <div data-float data-float-speed="0.04" class="absolute top-[28%] left-[52%] w-32 h-32 rounded-full bg-blue opacity-40 blur-2xl"></div>
    <div data-float data-float-speed="-0.02" class="absolute bottom-[18%] left-[8%] w-28 h-28 rounded-full bg-pink opacity-50 blur-2xl"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 relative w-full">
    <div class="max-w-3xl">
      {/* Availability badge */}
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-surface border border-border rounded-full mb-8 animate-fade-in-up shadow-sm">
        <span class="relative flex w-2 h-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75 animate-ping"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
        </span>
        <span class="text-xs font-medium text-text-secondary">Available for new projects</span>
      </div>

      <p class="text-xs font-medium text-accent tracking-[0.18em] uppercase mb-5 animate-fade-in-up flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        Product Designer
      </p>

      <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold text-text-primary leading-[1.05] mb-6 animate-fade-in-up animation-delay-100 tracking-tight">
        Hi, I'm <span class="relative inline-block group cursor-default">
          <span class="relative z-10">Chia-Ying</span>
          <span class="absolute bottom-1 left-0 w-full h-3 bg-orange -z-0 transition-all duration-500 group-hover:h-full group-hover:bg-yellow" aria-hidden="true"></span>
        </span><br/>
        I design{' '}
        <span class="relative inline-block" data-rotate-keyword aria-hidden="true">
          <span class="relative z-10 text-accent">experiences</span>
          <span class="absolute bottom-1 left-0 w-full h-3 bg-yellow -z-0"></span>
        </span>
        <span class="sr-only">experiences, products, systems, and interfaces</span>
      </h1>

      <p class="text-lg md:text-xl text-text-secondary max-w-2xl leading-relaxed mb-10 animate-fade-in-up animation-delay-200">
        A full-stack product designer who solves real user problems and delivers measurable business outcomes. I advocate for inclusive design and create accessible, human-centered experiences.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up animation-delay-300">
        <a
          href="#work"
          class="group inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-accent text-surface rounded-full font-medium text-sm hover:bg-accent-hover transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5"
        >
          View my work
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
        <a
          href="#contact"
          class="group inline-flex items-center justify-center px-8 py-3.5 border-2 border-text-primary/50 rounded-full font-medium text-sm text-text-primary hover:border-text-primary hover:bg-orange transition-all duration-300"
        >
          Get in touch
        </a>
      </div>

      {/* Inline stat strip */}
      <div class="mt-16 pt-8 pb-16 border-t border-border grid grid-cols-3 gap-4 md:gap-8 max-w-2xl animate-fade-in-up animation-delay-400">
        <div>
          <p class="text-2xl md:text-3xl font-bold text-text-primary">6+</p>
          <p class="text-xs md:text-sm text-text-tertiary mt-1">Years designing</p>
        </div>
        <div>
          <p class="text-2xl md:text-3xl font-bold text-text-primary">15+</p>
          <p class="text-xs md:text-sm text-text-tertiary mt-1">Products shipped</p>
        </div>
        <div>
          <p class="text-2xl md:text-3xl font-bold text-text-primary">10+</p>
          <p class="text-xs md:text-sm text-text-tertiary mt-1">Clients served</p>
        </div>
      </div>
    </div>

    {/* Scroll indicator */}
    <a href="#work" class="hidden md:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 text-text-tertiary hover:text-text-primary transition-colors group" aria-label="Scroll to work">
      <span class="text-xs uppercase tracking-widest">Scroll</span>
      <span class="w-px h-8 bg-current relative overflow-hidden">
        <span class="absolute inset-x-0 top-0 h-1/2 bg-accent animate-scroll-indicator"></span>
      </span>
    </a>
  </div>
</section>

<script>
  // Mouse parallax for decorative shapes (desktop only, respects reduced motion)
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isCoarse = window.matchMedia('(pointer: coarse)').matches;

  if (!reduceMotion && !isCoarse) {
    const shapes = document.querySelectorAll<HTMLElement>('[data-float]');
    let mx = 0, my = 0, tx = 0, ty = 0;

    window.addEventListener('mousemove', (e) => {
      mx = (e.clientX / window.innerWidth - 0.5) * 2;
      my = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    function raf() {
      tx += (mx - tx) * 0.08;
      ty += (my - ty) * 0.08;
      shapes.forEach((el) => {
        const speed = parseFloat(el.dataset.floatSpeed || '0.02');
        const x = tx * speed * 100;
        const y = ty * speed * 100;
        el.style.transform = `translate(${x}px, ${y}px)`;
      });
      requestAnimationFrame(raf);
    }
    raf();
  }

  // Rotating keyword — pauses on hover/focus of the headline
  if (!reduceMotion) {
    const words = ['experiences', 'products', 'systems', 'interfaces'];
    const el = document.querySelector<HTMLElement>('[data-rotate-keyword] span.relative');
    const headline = document.querySelector<HTMLElement>('h1');
    if (el) {
      let i = 0;
      let paused = false;
      const tick = () => {
        if (paused) return;
        i = (i + 1) % words.length;
        el.style.transition = 'opacity 0.3s, transform 0.3s';
        el.style.opacity = '0';
        el.style.transform = 'translateY(-8px)';
        setTimeout(() => {
          el.textContent = words[i];
          el.style.transform = 'translateY(8px)';
          requestAnimationFrame(() => {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          });
        }, 300);
      };
      setInterval(tick, 2400);

      headline?.addEventListener('mouseenter', () => { paused = true; });
      headline?.addEventListener('mouseleave', () => { paused = false; });
      headline?.addEventListener('focusin', () => { paused = true; });
      headline?.addEventListener('focusout', () => { paused = false; });
    }
  }
</script>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 18s linear infinite;
    transform-origin: center;
  }

  @keyframes scroll-indicator {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }
  .animate-scroll-indicator {
    animation: scroll-indicator 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-spin-slow,
    .animate-scroll-indicator {
      animation: none !important;
    }
  }
</style>
