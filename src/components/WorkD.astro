---
const projects = [
  {
    title: 'My Heathrow',
    description: 'Consolidating multiple airport services into a unified digital platform — improving passenger experience and driving loyalty engagement.',
    tags: ['Enterprise', 'UX Research', 'Design System'],
    href: '/work/my-heathrow',
    image: '/images/work/my-heathrow/hero.jpg',
    imageAlt: 'My Heathrow airport services platform showing the unified dashboard',
    surface: 'pink',
    metric: 'Loyalty engagement ↑',
  },
  {
    title: 'Kinship',
    description: 'A care support platform that connects carers with guidance and resources.',
    tags: ['Service', 'Accessibility'],
    href: '/work/kinship',
    image: '/images/work/kinship/hero.jpg',
    imageAlt: 'Kinship Connect — a guided sentence-builder form for kinship carers',
    surface: 'orange',
    imageBg: '#FEEECA',
    metric: '20 carer interviews',
  },
  {
    title: 'Cornershop',
    description: 'An omnichannel retail experience bridging digital and physical touchpoints.',
    tags: ['Retail', 'E-commerce'],
    href: '/work/cornershop',
    image: '/images/work/cornershop/hero.jpg',
    imageAlt: 'Cornershop retail operations dashboard',
    surface: 'blue',
    metric: 'Omnichannel blueprint',
  },
];

const surfaceMap: Record<string, string> = { pink: 'bg-pink', orange: 'bg-orange', yellow: 'bg-yellow', blue: 'bg-blue' };
---

<section id="work" class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal max-w-2xl mb-12">
      <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        Selected work
      </p>
      <h2 class="text-3xl md:text-4xl font-semibold text-text-primary mb-4">
        Recent case studies
      </h2>
      <p class="text-text-secondary text-lg">
        Three recent projects across enterprise, service, and retail.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-6 md:auto-rows-[minmax(220px,_auto)]">
      {/* Featured large card — spans 8 cols and 2 rows on md+ */}
      {(() => {
        const p = projects[0];
        const surfaceClass = surfaceMap[p.surface];
        return (
          <a
            href={p.href}
            class="reveal group relative md:col-span-8 md:row-span-2 rounded-2xl border border-border overflow-hidden block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/10"
          >
            <div
              class={`relative ${p.imageBg ? '' : surfaceClass} aspect-[16/10] md:aspect-auto md:h-full overflow-hidden`}
              style={p.imageBg ? `background-color: ${p.imageBg}` : undefined}
            >
              <img src={p.image} alt={p.imageAlt} loading="eager" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />
              {/* Bottom info gradient overlay */}
              <div class="absolute inset-x-0 bottom-0 p-6 md:p-8 bg-gradient-to-t from-black/85 via-black/50 to-transparent text-white">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-[11px] font-medium tracking-[0.2em] uppercase text-white/70">Featured</span>
                  <span class="w-1 h-1 rounded-full bg-white/40"></span>
                  <span class="text-[11px] font-medium uppercase tracking-wider text-white/70">{p.metric}</span>
                </div>
                <h3 class="text-2xl md:text-3xl font-semibold mb-2 transition-transform duration-500 group-hover:-translate-y-0.5">
                  {p.title}
                </h3>
                <p class="text-sm md:text-base text-white/85 leading-relaxed mb-4 max-w-2xl line-clamp-2">{p.description}</p>
                <div class="flex flex-wrap gap-2">
                  {p.tags.map((tag) => (
                    <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-white/15 backdrop-blur border border-white/20">{tag}</span>
                  ))}
                </div>
              </div>
              {/* Top-right arrow chip */}
              <span class="absolute top-5 right-5 inline-flex items-center justify-center w-10 h-10 rounded-full bg-surface/95 backdrop-blur text-text-primary shadow-md transition-transform duration-500 group-hover:rotate-45">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        );
      })()}

      {/* Two compact cards stacked in the right column */}
      {projects.slice(1).map((p, idx) => {
        const surfaceClass = surfaceMap[p.surface];
        return (
          <a
            href={p.href}
            class="reveal group relative md:col-span-4 rounded-2xl border border-border bg-surface overflow-hidden block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 transition-all duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/10"
            style={`transition-delay: ${(idx + 1) * 80}ms`}
          >
            <div
              class={`relative ${p.imageBg ? '' : surfaceClass} aspect-[16/10] overflow-hidden`}
              style={p.imageBg ? `background-color: ${p.imageBg}` : undefined}
            >
              <img src={p.image} alt={p.imageAlt} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05]" />
            </div>
            <div class="p-5 md:p-6">
              <p class="text-[11px] font-medium text-text-tertiary tracking-[0.2em] uppercase mb-2">{p.metric}</p>
              <h3 class="text-lg md:text-xl font-semibold text-text-primary mb-2 group-hover:text-accent transition-colors">
                {p.title}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed mb-3 line-clamp-2">{p.description}</p>
              <div class="flex items-center justify-between">
                <div class="flex flex-wrap gap-1.5">
                  {p.tags.map((tag) => (
                    <span class={`text-[10px] font-medium text-text-primary ${surfaceClass} px-2 py-0.5 rounded-full`}>{tag}</span>
                  ))}
                </div>
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-text-primary transition-all duration-300 group-hover:bg-accent group-hover:text-surface group-hover:rotate-45 shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
