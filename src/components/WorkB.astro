---
const projects = [
  {
    title: 'My Heathrow',
    description: 'Consolidating multiple airport services into a unified digital platform, improving passenger experience and driving loyalty engagement.',
    tags: ['Enterprise', 'UX Research', 'Design System'],
    category: 'Enterprise',
    href: '/work/my-heathrow',
    image: '/images/work/my-heathrow/hero.jpg',
    imageAlt: 'My Heathrow airport services platform showing the unified dashboard',
    surface: 'pink',
  },
  {
    title: 'Kinship',
    description: 'A care support platform that connects carers with guidance, resources, and community — making support more accessible.',
    tags: ['Service', 'Accessibility', 'Mobile'],
    category: 'Service',
    href: '/work/kinship',
    image: '/images/work/kinship/hero.jpg',
    imageAlt: 'Kinship Connect — a guided sentence-builder form for kinship carers',
    surface: 'orange',
    imageBg: '#FEEECA',
  },
  {
    title: 'Cornershop',
    description: 'An omnichannel retail experience bridging digital and physical touchpoints, with operations dashboards for staff.',
    tags: ['Retail', 'E-commerce', 'Service'],
    category: 'Retail',
    href: '/work/cornershop',
    image: '/images/work/cornershop/hero.jpg',
    imageAlt: 'Cornershop retail operations dashboard',
    surface: 'blue',
  },
];

const surfaceMap: Record<string, string> = { pink: 'bg-pink', orange: 'bg-orange', yellow: 'bg-yellow', blue: 'bg-blue' };
const categories = ['All', ...Array.from(new Set(projects.map((p) => p.category)))];
---

<section id="work" class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal max-w-2xl mb-10 md:mb-12">
      <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        Selected work
      </p>
      <h2 class="text-3xl md:text-4xl font-semibold text-text-primary mb-4">
        Recent case studies
      </h2>
      <p class="text-text-secondary text-lg">
        Enterprise and product design work — focused on real impact for users and business.
      </p>
    </div>

    {/* Filter pills */}
    <div class="reveal flex flex-wrap gap-2 mb-10 md:mb-12" role="tablist" aria-label="Filter case studies by category">
      {categories.map((cat, i) => (
        <button
          type="button"
          role="tab"
          data-filter-btn
          data-cat={cat}
          aria-selected={i === 0 ? 'true' : 'false'}
          class:list={[
            'inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium border transition-all duration-300',
            i === 0
              ? 'bg-accent text-surface border-accent'
              : 'bg-surface text-text-secondary border-border hover:border-text-primary hover:text-text-primary',
          ]}
        >
          {cat}
        </button>
      ))}
    </div>

    {/* Card grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" data-card-grid>
      {projects.map((project, i) => {
        const surfaceClass = surfaceMap[project.surface];
        const number = String(i + 1).padStart(2, '0');
        return (
          <a
            href={project.href}
            data-card
            data-cat={project.category}
            class="group reveal relative block rounded-2xl border border-border bg-surface overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-black/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            style={`transition-delay: ${i * 60}ms`}
          >
            {/* Top accent bar — slides in on hover */}
            <span class="absolute top-0 left-0 right-0 h-1 bg-accent origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out z-10" aria-hidden="true"></span>

            <div
              class={`relative overflow-hidden ${project.imageBg ? '' : surfaceClass} aspect-[5/4]`}
              style={project.imageBg ? `background-color: ${project.imageBg}` : undefined}
            >
              <img
                src={project.image}
                alt={project.imageAlt}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
              />
              {/* Project number badge */}
              <span class="absolute top-4 left-4 inline-flex items-center justify-center w-10 h-10 rounded-full bg-surface/90 backdrop-blur text-xs font-semibold text-text-primary shadow-sm">
                {number}
              </span>
            </div>

            <div class="p-6 md:p-7">
              <div class="flex flex-wrap gap-2 mb-3">
                {project.tags.map((tag) => (
                  <span class={`text-[11px] font-medium text-text-primary ${surfaceClass} px-2.5 py-1 rounded-full`}>{tag}</span>
                ))}
              </div>
              <h3 class="text-xl md:text-2xl font-semibold text-text-primary mb-3 group-hover:text-accent transition-colors">
                {project.title}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed mb-5 line-clamp-3">
                {project.description}
              </p>
              <span class="inline-flex items-center gap-2 text-sm font-medium text-text-primary">
                View case study
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>

    {/* Empty state for filters that match nothing — hidden by default */}
    <p data-empty-state class="hidden text-center text-text-tertiary text-sm mt-10">
      No case studies in this category yet.
    </p>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
  const cards = document.querySelectorAll<HTMLElement>('[data-card]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

  function applyFilter(cat: string) {
    let visible = 0;
    cards.forEach((card) => {
      const match = cat === 'All' || card.dataset.cat === cat;
      if (match) {
        visible++;
        card.style.display = '';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.97)';
        requestAnimationFrame(() => {
          card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          card.style.opacity = '1';
          card.style.transform = 'scale(1)';
        });
      } else {
        card.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.97)';
        setTimeout(() => { card.style.display = 'none'; }, 250);
      }
    });
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat || 'All';
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active) {
          b.classList.add('bg-accent', 'text-surface', 'border-accent');
          b.classList.remove('bg-surface', 'text-text-secondary', 'border-border', 'hover:border-text-primary', 'hover:text-text-primary');
        } else {
          b.classList.remove('bg-accent', 'text-surface', 'border-accent');
          b.classList.add('bg-surface', 'text-text-secondary', 'border-border', 'hover:border-text-primary', 'hover:text-text-primary');
        }
      });
      applyFilter(cat);
    });
  });
</script>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
