---
interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;

const icons = {
  research: 'm21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z',
  craft: 'M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z',
  access: 'M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z;M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  outcome: 'M2.25 18 9 11.25l4.306 4.307a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941',
};

const t = lang === 'zh'
  ? {
      eyebrow: '我能帶來什麼',
      headLead: '我為',
      headHighlight: '影響力',
      headTail: '而設計 — 打造解決真實問題、帶來可衡量成果並提升參與度的產品。',
      pillars: [
        { surface: 'bg-pink', title: '研究驅動的策略', body: '我將使用者訊號（訪談、數據分析、客服紀錄）轉化為團隊能真正落地的產品方向。沒有證據，就沒有設計。', icon: icons.research },
        { surface: 'bg-orange', title: '端到端的產品打造', body: '從探索、資訊架構、流程、介面、原型到設計系統，我都能勝任。我能將混亂的問題梳理成可交付的規格，且始終不偏離使用者。', icon: icons.craft },
        { surface: 'bg-yellow', title: '預設即無障礙', body: 'WCAG 2.1 AA 是基準，而非天花板。我以鍵盤優先、螢幕閱讀器及真實情境為設計考量，並將這份視角帶進每一個團隊。', icon: icons.access },
        { surface: 'bg-blue', title: '可衡量的成果', body: '我將設計決策與利害關係人在意的數字連結 — 參與度、完成率、採用率 — 讓影響力在專案上線後依然清晰可見。', icon: icons.outcome },
      ],
    }
  : {
      eyebrow: 'What I bring',
      headLead: 'I design for ',
      headHighlight: 'impact',
      headTail: ' — products that solve real problems, deliver measurable outcomes, and drive engagement.',
      pillars: [
        { surface: 'bg-pink', title: 'Research-led strategy', body: 'I turn user signals — interviews, analytics, support tickets — into product direction teams can actually ship. No design without evidence.', icon: icons.research },
        { surface: 'bg-orange', title: 'End-to-end product craft', body: 'Comfortable across the stack: discovery, IA, flows, UI, prototypes, and design systems. I move from messy problem to handed-off spec without dropping the user.', icon: icons.craft },
        { surface: 'bg-yellow', title: 'Accessible by default', body: 'WCAG 2.1 AA is the floor, not the ceiling. I design for keyboard-first, screen readers, and real-world conditions — and I bring that lens to every team I join.', icon: icons.access },
        { surface: 'bg-blue', title: 'Measurable outcomes', body: 'I tie design decisions to numbers stakeholders care about — engagement, completion, adoption — so the impact is visible long after the project ships.', icon: icons.outcome },
      ],
    };

const pillars = t.pillars;
---

<section id="value" class="py-20 md:py-28 bg-gradient-value relative overflow-hidden">
  {/* Yellow ellipse continuation from hero */}
  <div
    class="absolute -top-40 right-[10%] w-96 h-96 rounded-full bg-yellow opacity-90 blur-2xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-5xl mx-auto px-6 relative">
    <div class="reveal mb-14">
      <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        {t.eyebrow}
      </p>
      <h2 class="text-3xl md:text-4xl font-semibold text-text-primary leading-tight max-w-5xl">
        {t.headLead}<span class="relative inline-block">
          <span class="relative z-10">{t.headHighlight}</span>
          <span class="absolute bottom-1 left-0 w-full h-3 bg-yellow -z-0" aria-hidden="true"></span>
        </span>{t.headTail}
      </h2>
    </div>

    {/* 2x2 grid — icon + content per row */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
      {pillars.map((pillar, i) => {
        const paths = pillar.icon.split(';');
        return (
          <div
            class="reveal flex gap-5 rounded-2xl border border-border bg-surface/85 backdrop-blur-sm p-6 md:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-text-tertiary/30"
            style={`transition-delay: ${i * 60}ms`}
          >
            <div class={`shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-xl ${pillar.surface} flex items-center justify-center text-text-primary`}>
              <svg class="w-6 h-6 md:w-7 md:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                {paths.map((d) => (
                  <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                ))}
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-[11px] font-semibold text-text-tertiary tracking-[0.18em] uppercase mb-2">
                0{i + 1}
              </p>
              <h3 class="text-base md:text-lg font-semibold text-text-primary mb-2 leading-snug">
                {pillar.title}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                {pillar.body}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
