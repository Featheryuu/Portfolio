---
const experience = [
  {
    role: 'Product Designer',
    company: 'Capgemini',
    period: '2021 – 2024',
    description: 'Leading design for enterprise clients including Heathrow Airport and Lloyds Bank. Creating accessible, scalable design systems and user-centered digital experiences.',
  },
  {
    role: 'UX / Service Designer',
    company: 'Snook (NEC Digital)',
    period: '2020 – 2022',
    description: 'Designed care support platforms, improving access to guidance and resources for carers and families across the UK.',
  },
];
---

<section id="about" class="py-20 md:py-28 bg-gradient-soft relative overflow-visible">
  {/* Bridge blob — peeks up into the section above for soft transition */}
  <div
    class="absolute -top-40 right-[15%] w-96 h-96 rounded-full bg-orange opacity-40 blur-2xl pointer-events-none"
    aria-hidden="true"
  ></div>

  {/* Floating decorative shapes — mirrors Hero treatment with another placement */}
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div data-float data-float-speed="0.03" class="absolute top-[15%] right-[20%] w-32 h-32 rounded-full bg-blue opacity-40 blur-2xl"></div>
    <div data-float data-float-speed="-0.025" class="absolute top-[60%] left-[10%] w-36 h-36 rounded-full bg-yellow opacity-50 blur-2xl"></div>
    <div data-float data-float-speed="0.04" class="absolute bottom-[10%] right-[8%] w-28 h-28 rounded-full bg-pink opacity-50 blur-2xl"></div>
    <div data-float data-float-speed="-0.02" class="absolute top-[30%] left-[40%] w-24 h-24 rounded-full bg-orange opacity-40 blur-xl"></div>
  </div>

  <div class="max-w-5xl mx-auto px-6 relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      {/* Bio */}
      <div class="reveal">
        <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-accent"></span>
          About
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold text-text-primary mb-6">
          Designer with a human focus
        </h2>
        <div class="space-y-4 text-text-secondary leading-relaxed">
          <p>
            I'm an interdisciplinary product designer with a passion for creating meaningful digital experiences that put people first. Based in London, I work across the full product lifecycle — from research and strategy to detailed UI and design systems.
          </p>
          <p>
            I advocate for inclusive design and accessibility, believing that the best products serve everyone. My approach combines analytical thinking with creative problem-solving, always grounded in real user needs and measurable outcomes.
          </p>
        </div>
      </div>

      {/* Experience */}
      <div class="reveal" style="transition-delay: 100ms">
        <h3 class="text-lg font-semibold text-text-primary mb-6">
          Experience
        </h3>
        <div class="space-y-8">
          {experience.map((job) => (
            <div
              tabindex="0"
              aria-label={`${job.role} at ${job.company}, ${job.period}`}
              class="relative pl-6 border-l-2 border-border rounded-r-lg transition-all duration-300 hover:border-accent focus-visible:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
            >
              <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-accent"></div>
              <p class="text-xs font-medium text-text-tertiary uppercase tracking-wider mb-1">
                {job.period}
              </p>
              <h4 class="text-base font-semibold text-text-primary">
                {job.role}
              </h4>
              <p class="text-sm text-accent mb-2">{job.company}</p>
              <p class="text-sm text-text-secondary leading-relaxed">
                {job.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
