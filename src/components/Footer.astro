---
interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;
const currentYear = new Date().getFullYear();
const base = lang === 'zh' ? '/zh' : '';

const t = lang === 'zh'
  ? {
      eyebrow: '聯絡我',
      headLead: '一起打造',
      headHighlight: '有意義',
      headTail: '的作品',
      blurb: '我隨時樂於討論新專案、創意想法，或成為你願景的一部分。',
      email: '寄信給我',
      cv: '下載履歷',
      work: '作品',
      about: '關於',
      contact: '聯絡',
    }
  : {
      eyebrow: 'Get in touch',
      headLead: "Let's create something ",
      headHighlight: 'meaningful',
      headTail: '',
      blurb: "I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.",
      email: 'Email me',
      cv: 'Download CV',
      work: 'Work',
      about: 'About',
      contact: 'Contact',
    };
---

<footer id="contact" class="border-t border-border bg-pink relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 py-20 relative">
    <div class="reveal flex flex-col items-center text-center gap-6">
      <p class="text-xs font-medium text-accent uppercase tracking-[0.18em] mb-1 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        {t.eyebrow}
        <span class="inline-block w-8 h-px bg-accent"></span>
      </p>
      <h2 class="text-3xl md:text-4xl font-semibold text-text-primary">
        {t.headLead}<span class="relative inline-block">
          <span class="relative z-10">{t.headHighlight}</span>
          <span class="absolute bottom-1 left-0 w-full h-3 bg-yellow -z-0" aria-hidden="true"></span>
        </span>{t.headTail}
      </h2>
      <p class="text-text-secondary max-w-md">
        {t.blurb}
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-4 mt-2">
        <a
          href="mailto:hellochiaying@gmail.com"
          class="group inline-flex items-center gap-2 px-7 py-3.5 bg-accent text-surface rounded-full font-medium text-sm hover:bg-accent-hover transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5"
          aria-label="Send email"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {t.email}
        </a>
        <a
          href="https://www.linkedin.com/in/chiayingtsai/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-7 py-3.5 border-2 border-text-primary/50 text-text-primary rounded-full font-medium text-sm hover:border-text-primary hover:bg-surface transition-all duration-300"
          aria-label="LinkedIn profile (opens in new tab)"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <a
          href="https://drive.google.com/file/d/1n0CbwqXHMu194CTtQIX4uspnyrIwdy4q/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-7 py-3.5 border-2 border-text-primary/50 text-text-primary rounded-full font-medium text-sm hover:border-text-primary hover:bg-surface transition-all duration-300"
          aria-label="Download CV PDF (opens in new tab)"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
          </svg>
          {t.cv}
        </a>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-3 gap-6 items-center">
      {/* Sitemap */}
      <nav class="flex flex-wrap justify-center sm:justify-start gap-5" aria-label="Footer navigation">
        <a href={`${base}/#work`} class="text-sm text-text-secondary hover:text-text-primary transition-colors">{t.work}</a>
        <a href={`${base}/#about`} class="text-sm text-text-secondary hover:text-text-primary transition-colors">{t.about}</a>
        <a href={`${base}/#contact`} class="text-sm text-text-secondary hover:text-text-primary transition-colors">{t.contact}</a>
      </nav>

      {/* Copyright */}
      <p class="text-sm text-text-tertiary text-center">
        &copy; {currentYear} Chia-Ying Tsai
      </p>

      {/* Social icons */}
      <div class="flex justify-center sm:justify-end gap-2">
        <a
          href="mailto:hellochiaying@gmail.com"
          class="w-9 h-9 rounded-full border border-border bg-surface flex items-center justify-center text-text-secondary hover:text-text-primary hover:border-text-primary transition-colors"
          aria-label="Email"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/chiayingtsai/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-9 h-9 rounded-full border border-border bg-surface flex items-center justify-center text-text-secondary hover:text-text-primary hover:border-text-primary transition-colors"
          aria-label="LinkedIn profile (opens in new tab)"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
