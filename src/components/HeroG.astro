---
interface Props {
  lang?: 'en' | 'zh';
  sketch?: 'squiggle' | 'squiggle2' | 'hybrid' | 'synthesis' | 'craft' | 'system' | 'system2' | 'system3';
  stroke?: 'fine' | 'pencil' | 'soft' | 'ink' | 'marker';
  outcome?: 'metrics' | 'system' | 'surfaces' | 'people';
}
const { lang = 'en', sketch = 'squiggle', stroke = 'pencil', outcome = 'metrics' } = Astro.props;
import HeroSketch from './HeroSketch.astro';
const base = lang === 'zh' ? '/zh' : '';

const t = lang === 'zh'
  ? {
      ebLead: '嗨，',
      ebMark: '我是佳穎',
      ebTail: '，產品設計師',
      headLead: '我把複雜的問題，做成人們',
      headHighlight: '信任',
      headTail: '的產品。',
      subLead: '六年橫跨企業與新創的端到端設計經驗：',
      proofs: [
        { dot: 'bg-pink', text: '找出真正問題的研究' },
        { dot: 'bg-orange', text: '可規模化的系統' },
        { dot: 'bg-yellow', text: '經得起真實世界考驗的介面' },
      ],
      viewWork: '查看作品',
      getInTouch: '聯絡我',
      labelStart: '混沌',
      labelEnd: '上線',
      noteResearch: '研究',
      noteTest: '測試',
      noteShip: '交付',
    }
  : {
      ebLead: 'Hi, ',
      ebMark: "I'm Chia-Ying",
      ebTail: ', Product Designer',
      headLead: 'I turn complexity into products people ',
      headHighlight: 'trust',
      headTail: '.',
      subLead: 'Six years of end-to-end design across enterprise and startups:',
      proofs: [
        { dot: 'bg-pink', text: 'research that finds the real problem' },
        { dot: 'bg-orange', text: 'systems that scale' },
        { dot: 'bg-yellow', text: 'interfaces that hold up in the real world' },
      ],
      viewWork: 'View my work',
      getInTouch: 'Get in touch',
      labelStart: 'messy',
      labelEnd: 'shipped',
      noteResearch: 'research',
      noteTest: 'test',
      noteShip: 'ship',
    };
---

<section class="relative overflow-hidden bg-bg-primary min-h-[92vh] flex items-center">
  {/* Soft ellipses — unchanged background */}
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div
      data-drift
      data-drift-speed="0.025"
      class="absolute -top-32 -right-24 w-[36rem] h-[36rem] rounded-full opacity-100 blur-2xl will-change-transform"
      style="background: radial-gradient(circle at 40% 40%, var(--color-pink) 0%, var(--color-orange) 70%, transparent 100%);"
    ></div>
    <div
      data-drift
      data-drift-speed="-0.03"
      class="absolute top-[40%] right-[6%] w-72 h-72 rounded-full bg-blue opacity-100 blur-2xl shape-breathe will-change-transform"
    ></div>
    <div
      data-drift
      data-drift-speed="0.02"
      class="absolute -bottom-20 right-[14%] w-80 h-80 rounded-full bg-yellow opacity-100 blur-2xl will-change-transform"
    ></div>
    <div class="absolute bottom-[14%] left-[6%] w-56 h-56 rounded-full bg-pink opacity-95 blur-2xl"></div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-16 md:py-24 relative w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      {/* Text column */}
      <div class="lg:col-span-7">
        <div class="inline-block mb-6 animate-fade-in-up">
          <p class="text-[13px] sm:text-base md:text-lg font-semibold text-accent tracking-[0.05em] uppercase whitespace-nowrap">
            {t.ebLead}<span class="relative inline-block">{t.ebMark}{/* Hand-drawn underline, same pencil language as the hero sketch */}<svg
              class="eyebrow-rule absolute left-0 -bottom-1.5 w-full h-2 text-text-tertiary"
              viewBox="0 0 140 8"
              fill="none"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <filter id="eyebrow-pencil" x="-4%" y="-60%" width="108%" height="220%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="3" seed="4" result="n"/>
                  <feDisplacementMap in="SourceGraphic" in2="n" scale="1.4" xChannelSelector="R" yChannelSelector="G"/>
                </filter>
              </defs>
              <path
                d="M3 5 C 26 2, 50 6.5, 72 4 C 92 1.8, 116 6, 137 3.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
                filter="url(#eyebrow-pencil)"
              />
            </svg></span>{t.ebTail}
          </p>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-text-primary leading-[1.1] mb-6 animate-fade-in-up animation-delay-100 tracking-tight">
          {t.headLead}<span class="whitespace-nowrap"><span class="relative inline-block">
            <span class="relative z-10">{t.headHighlight}</span>
            <span class="absolute bottom-1 left-0 w-full h-3 bg-yellow -z-0" aria-hidden="true"></span>
          </span>{t.headTail}</span>
        </h1>

        <p class="text-lg text-text-secondary leading-relaxed mb-4 animate-fade-in-up animation-delay-200">
          {t.subLead}
        </p>
        <ul class="space-y-2.5 mb-9 animate-fade-in-up animation-delay-200" role="list">
          {t.proofs.map((p) => (
            <li class="flex items-start gap-3 text-base text-text-secondary">
              <span class={`w-2 h-2 rounded-full ${p.dot} ring-1 ring-text-primary/15 shrink-0 mt-2`}></span>
              {p.text}
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up animation-delay-300">
          <a
            href={`${base}/#work`}
            class="group inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-accent text-surface rounded-full font-medium text-sm hover:bg-accent-hover transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5"
          >
            {t.viewWork}
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
          <a
            href={`${base}/#contact`}
            class="group inline-flex items-center justify-center px-8 py-3.5 border-2 border-text-primary/50 rounded-full font-medium text-sm text-text-primary hover:border-text-primary hover:bg-orange transition-all duration-300"
          >
            {t.getInTouch}
          </a>
        </div>
      </div>

      {/* Hand-drawn design squiggle — chaos resolving into a shipped line */}
      <div class="lg:col-span-5 relative animate-fade-in-up animation-delay-300 lg:scale-[1.32] lg:origin-left">
        <HeroSketch variant={sketch} lang={lang} stroke={stroke} outcome={outcome} uid="hero" />
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isCoarse = window.matchMedia('(pointer: coarse)').matches;

  if (!reduceMotion && !isCoarse) {
    const shapes = document.querySelectorAll<HTMLElement>('[data-drift]');
    let mx = 0, my = 0, tx = 0, ty = 0;

    window.addEventListener('mousemove', (e) => {
      mx = (e.clientX / window.innerWidth - 0.5) * 2;
      my = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    function raf() {
      tx += (mx - tx) * 0.06;
      ty += (my - ty) * 0.06;
      shapes.forEach((el) => {
        const speed = parseFloat(el.dataset.driftSpeed || '0.02');
        el.style.transform = `translate(${tx * speed * 100}px, ${ty * speed * 100}px)`;
      });
      requestAnimationFrame(raf);
    }
    raf();
  }
</script>

<style>
  .eyebrow-rule path {
    stroke-dasharray: 150;
    stroke-dashoffset: 150;
    animation: draw-rule 0.75s cubic-bezier(0.3, 0, 0.2, 1) 0.35s forwards;
  }
  @keyframes draw-rule { to { stroke-dashoffset: 0; } }


  @keyframes shape-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.06); }
  }
  .shape-breathe {
    animation: shape-breathe 6s ease-in-out infinite;
    transform-origin: center;
  }

  /* The line draws itself in on load, like being sketched */
  .squiggle {
    stroke-dasharray: 3200;
    stroke-dashoffset: 3200;
    animation: draw-squiggle 3.4s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
  }
  .squiggle-arrow {
    opacity: 0;
    animation: fade-in-arrow 0.4s ease-out 3.4s forwards;
  }
  @keyframes draw-squiggle {
    to { stroke-dashoffset: 0; }
  }
  @keyframes fade-in-arrow {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shape-breathe { animation: none !important; }
    .eyebrow-rule path { animation: none !important; stroke-dashoffset: 0; }
    .squiggle {
      animation: none !important;
      stroke-dashoffset: 0;
    }
    .squiggle-arrow {
      animation: none !important;
      opacity: 1;
    }
  }
</style>
