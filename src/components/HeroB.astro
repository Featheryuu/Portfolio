---
interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;
const base = lang === 'zh' ? '/zh' : '';

const t = lang === 'zh'
  ? {
      eyebrow: '嗨，我是佳穎，產品設計師',
      headLead: '我設計人們',
      headHighlight: '真正用得上手',
      headTail: '的企業產品。',
      subLead: '六年橫跨企業與新創的端到端設計經驗：',
      proofs: [
        { dot: 'bg-pink', text: '找出真正問題的研究' },
        { dot: 'bg-orange', text: '可規模化的系統' },
        { dot: 'bg-yellow', text: '經得起真實世界考驗的介面' },
      ],
      stats: [
        { n: '6+', l: '設計年資' },
        { n: '15+', l: '產品上線' },
        { n: '10+', l: '服務客戶' },
      ],
      viewWork: '查看作品',
      getInTouch: '聯絡我',
    }
  : {
      eyebrow: "Hi, I'm Chia-Ying, Product Designer",
      headLead: 'I design enterprise products people can ',
      headHighlight: 'actually use',
      headTail: '.',
      subLead: 'Six years of end-to-end design across enterprise and startups:',
      proofs: [
        { dot: 'bg-pink', text: 'research that finds the real problem' },
        { dot: 'bg-orange', text: 'systems that scale' },
        { dot: 'bg-yellow', text: 'interfaces that hold up in the real world' },
      ],
      stats: [
        { n: '6+', l: 'Years designing' },
        { n: '15+', l: 'Products shipped' },
        { n: '10+', l: 'Clients served' },
      ],
      viewWork: 'View my work',
      getInTouch: 'Get in touch',
    };
---

<section class="relative overflow-hidden bg-bg-primary min-h-[92vh] flex items-center">
  {/* Soft ellipses — white background, lighter blur, higher opacity */}
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    {/* Large warm pink/orange ellipse — top-right */}
    <div
      data-drift
      data-drift-speed="0.025"
      class="absolute -top-32 -right-24 w-[36rem] h-[36rem] rounded-full opacity-100 blur-2xl will-change-transform"
      style="background: radial-gradient(circle at 40% 40%, var(--color-pink) 0%, var(--color-orange) 70%, transparent 100%);"
    ></div>
    {/* Blue ellipse — middle-right */}
    <div
      data-drift
      data-drift-speed="-0.03"
      class="absolute top-[40%] right-[6%] w-72 h-72 rounded-full bg-blue opacity-100 blur-2xl shape-breathe will-change-transform"
    ></div>
    {/* Yellow ellipse — bottom-right */}
    <div
      data-drift
      data-drift-speed="0.02"
      class="absolute -bottom-20 right-[14%] w-80 h-80 rounded-full bg-yellow opacity-100 blur-2xl will-change-transform"
    ></div>
    {/* Small pink ellipse — bottom-left */}
    <div
      class="absolute bottom-[14%] left-[6%] w-56 h-56 rounded-full bg-pink opacity-95 blur-2xl"
    ></div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-16 md:py-24 relative w-full">
    <div class="max-w-3xl">
      <p class="text-base md:text-xl font-semibold text-accent tracking-[0.08em] uppercase mb-5 animate-fade-in-up flex items-center gap-3">
        <span class="inline-block w-10 h-px bg-accent"></span>
        {t.eyebrow}
      </p>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary leading-[1.1] mb-6 animate-fade-in-up animation-delay-100 tracking-tight">
        {t.headLead}<span class="relative inline-block">
          <span class="relative z-10">{t.headHighlight}</span>
          <span class="absolute bottom-1 left-0 w-full h-3 bg-yellow -z-0" aria-hidden="true"></span>
        </span>{t.headTail}
      </h1>

      {/* Subline: lead-in + scannable proof list */}
      <p class="text-lg md:text-xl text-text-secondary leading-relaxed mb-4 animate-fade-in-up animation-delay-200">
        {t.subLead}
      </p>
      <ul class="space-y-2.5 mb-10 animate-fade-in-up animation-delay-200" role="list">
        {t.proofs.map((p) => (
          <li class="flex items-start gap-3 text-base md:text-lg text-text-secondary">
            <span class={`w-2 h-2 rounded-full ${p.dot} ring-1 ring-text-primary/15 shrink-0 mt-2 md:mt-2.5`}></span>
            {p.text}
          </li>
        ))}
      </ul>

      {/* Inline stat strip */}
      <div class="mb-10 pb-8 grid grid-cols-3 gap-4 md:gap-8 max-w-2xl animate-fade-in-up animation-delay-250">
        {t.stats.map((s) => (
          <div>
            <p class="text-2xl md:text-3xl font-bold text-text-primary">{s.n}</p>
            <p class="text-xs md:text-sm text-text-tertiary mt-1">{s.l}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up animation-delay-300">
        <a
          href={`${base}/#work`}
          class="group inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-accent text-surface rounded-full font-medium text-sm hover:bg-accent-hover transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5"
        >
          {t.viewWork}
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
        <a
          href={`${base}/#contact`}
          class="group inline-flex items-center justify-center px-8 py-3.5 border-2 border-text-primary/50 rounded-full font-medium text-sm text-text-primary hover:border-text-primary hover:bg-orange transition-all duration-300"
        >
          {t.getInTouch}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isCoarse = window.matchMedia('(pointer: coarse)').matches;

  // Mouse parallax for drifting shapes (desktop only, respects reduced motion)
  if (!reduceMotion && !isCoarse) {
    const shapes = document.querySelectorAll<HTMLElement>('[data-drift]');
    let mx = 0, my = 0, tx = 0, ty = 0;

    window.addEventListener('mousemove', (e) => {
      mx = (e.clientX / window.innerWidth - 0.5) * 2;
      my = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    function raf() {
      tx += (mx - tx) * 0.06;
      ty += (my - ty) * 0.06;
      shapes.forEach((el) => {
        const speed = parseFloat(el.dataset.driftSpeed || '0.02');
        const x = tx * speed * 100;
        const y = ty * speed * 100;
        el.style.transform = `translate(${x}px, ${y}px)`;
      });
      requestAnimationFrame(raf);
    }
    raf();
  }
</script>

<style>
  /* Orange circle — gentle breathing scale */
  @keyframes shape-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.06); }
  }
  .shape-breathe {
    animation: shape-breathe 6s ease-in-out infinite;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .shape-breathe {
      animation: none !important;
    }
  }
</style>
