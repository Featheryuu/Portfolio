---
interface Props {
  variant?: 'squiggle' | 'squiggle2' | 'hybrid' | 'synthesis' | 'craft' | 'system' | 'system2' | 'system3';
  /** Line quality: fine pencil, or a broad felt-tip marker */
  stroke?: 'fine' | 'pencil' | 'soft' | 'ink' | 'marker';
  /** What the lower branch of the hybrid sketch delivers */
  outcome?: 'metrics' | 'system' | 'surfaces' | 'people';
  lang?: 'en' | 'zh';
  /** Unique suffix so multiple sketches on one page don't share filter ids */
  uid?: string;
}
const { variant = 'squiggle', lang = 'en', uid = variant, stroke = 'pencil', outcome = 'metrics' } = Astro.props;
const fid = `ink-${uid}`;

// Marker lays down a broader, smoother line; pencil is finer and wobblier.
const STROKES = {
  // hard pencil — thin, scratchy
  fine:   { main: 1.7, mid: 1.5, thin: 1.3, hair: 1.1, disp: 3.6, freq: 0.042, alpha: 0.85 },
  // HB pencil — the current default
  pencil: { main: 2.6, mid: 2.2, thin: 1.8, hair: 1.6, disp: 3,   freq: 0.03,  alpha: 1 },
  // soft graphite — heavier, looser
  soft:   { main: 3.6, mid: 3,   thin: 2.4, hair: 2,   disp: 3.4, freq: 0.024, alpha: 0.95 },
  // fineliner — thin but steady, almost no wobble
  ink:    { main: 2,   mid: 1.8, thin: 1.5, hair: 1.3, disp: 0.7, freq: 0.02,  alpha: 1 },
  // felt-tip marker — broad and smooth
  marker: { main: 5.2, mid: 4.2, thin: 2.8, hair: 2.2, disp: 1.5, freq: 0.013, alpha: 0.92 },
};
const W = STROKES[stroke] ?? STROKES.pencil;

const L = lang === 'zh'
  ? {
      squiggle: { start: '混沌', end: '上線', n1: '研究', n2: '測試', n3: '交付', alt: '手繪示意圖：雜亂的線條逐漸收斂為一條清晰的線' },
      synthesis: { start: '訊號', end: '主題', alt: '手繪示意圖：散落的便利貼被整理成清晰的主題' },
      craft: { start: '草圖', end: '介面', alt: '手繪示意圖：粗略草圖演變為完成的介面' },
      system: { label: '一套系統', alt: '手繪示意圖：相互連結的節點構成一套完整系統' },
      squiggle2: { start: '起點', end: '成果', alt: '手繪示意圖：纏繞的線條向右上方逐漸展開為清晰的方向' },
      system2: { label: '一套系統', alt: '手繪示意圖：以手繪波浪線相連的節點構成一套系統' },
      hybrid: { start: '過程', end: '上線', alt: '手繪示意圖：雜亂的線條收斂後，分為介面與成效兩個方向' },
      system3: { start: '過程', end: '上線介面', alt: '手繪示意圖：纏繞的線條收斂為相互連結的系統節點' },
    }
  : {
      squiggle: { start: 'messy', end: 'shipped', n1: 'research', n2: 'test', n3: 'ship', alt: 'Hand-drawn illustration: a tangle of lines resolving into one clear line' },
      synthesis: { start: 'signals', end: 'themes', alt: 'Hand-drawn illustration: scattered notes organised into clear themes' },
      craft: { start: 'sketch', end: 'interface', alt: 'Hand-drawn illustration: a rough sketch becoming a finished interface' },
      system: { label: 'one system', alt: 'Hand-drawn illustration: connected nodes forming one coherent system' },
      squiggle2: { start: 'start', end: 'outcome', alt: 'Hand-drawn illustration: a tangle unwinding upward into a clear direction' },
      system2: { label: 'one system', alt: 'Hand-drawn illustration: nodes joined by hand-drawn wavy connections' },
      hybrid: { start: 'process', end: 'shipped', alt: 'Hand-drawn illustration: a tangle resolving then branching into a shipped interface and measurable impact' },
      system3: { start: 'process', end: 'shipped', alt: 'Hand-drawn illustration: a tangle resolving into connected system nodes' },
    };

const alt = L[variant].alt;
---

<svg class="w-full h-auto sketch" viewBox="0 0 520 300" fill="none" role="img" aria-label={alt}>
  <defs>
    <filter id={fid} x="-8%" y="-8%" width="116%" height="116%">
      <feTurbulence type="fractalNoise" baseFrequency={W.freq} numOctaves="3" seed="7" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale={W.disp} xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </defs>

  {variant === 'squiggle' && (
    <>
      <g filter={`url(#${fid})`}>
        <path d="M78 96 C 56 84, 50 122, 70 138 C 92 155, 128 136, 122 112 C 118 92, 98 90, 78 96 Z" class="fill-[var(--color-pink)]" opacity="0.5"/>
        <path d="M232 206 C 212 199, 204 228, 222 238 C 243 250, 268 233, 262 216 C 256 201, 246 202, 232 206 Z" class="fill-[var(--color-orange)]" opacity="0.42"/>
        <path d="M392 88 C 373 83, 365 111, 382 121 C 401 132, 425 117, 419 101 C 414 87, 405 86, 392 88 Z" class="fill-[var(--color-blue)]" opacity="0.45"/>
        <path
          d="M46 168 C 22 134, 48 98, 82 111 C 116 123, 94 177, 60 170 C 26 163, 35 111, 71 98
             C 107 86, 132 134, 105 166 C 78 199, 40 172, 56 134 C 72 97, 130 99, 139 138
             C 148 178, 105 200, 89 172 C 73 143, 114 115, 152 129 C 190 143, 174 195, 143 191
             C 112 187, 129 137, 170 137 C 211 137, 218 185, 193 191 C 168 196, 179 149, 215 151
             C 251 153, 253 183, 238 185 C 224 187, 235 158, 267 161 C 299 164, 301 177, 288 178
             C 276 179, 287 166, 316 168 C 344 170, 348 173, 341 174 C 334 175, 344 170, 369 171 L 470 171"
          stroke="var(--color-text-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="squiggle"/>
        <path d="M454 159 L 474 171 L 454 183" stroke="var(--color-text-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="squiggle-arrow"/>
        <path d="M386 186 C 411 192, 439 190, 466 185" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round" opacity="0.7"/>
        <path d="M170 74 l0 -14 M163 67 l14 0" stroke="var(--color-text-primary)" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
        <circle cx="432" cy="128" r="4" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width="1.6"/>
      </g>
      <text x="42" y="230" class="sk-label" fill="var(--color-text-tertiary)">{L.squiggle.start}</text>
      <text x="412" y="216" class="sk-label" fill="var(--color-text-tertiary)">{L.squiggle.end}</text>
      <g class="sk-note" style="rotate:-3deg">
        <path d="M196 84 h72 v30 h-72 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width="1.7" filter={`url(#${fid})`}/>
        <text x="232" y="103" text-anchor="middle" class="sk-note-text" fill="var(--color-text-primary)">{L.squiggle.n1}</text>
      </g>
      <g class="sk-note" style="rotate:2.5deg">
        <path d="M288 250 h58 v30 h-58 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width="1.7" filter={`url(#${fid})`}/>
        <text x="317" y="269" text-anchor="middle" class="sk-note-text" fill="var(--color-text-primary)">{L.squiggle.n2}</text>
      </g>
      <g class="sk-note" style="rotate:-2deg">
        <path d="M420 62 h58 v30 h-58 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width="1.7" filter={`url(#${fid})`}/>
        <text x="449" y="81" text-anchor="middle" class="sk-note-text" fill="var(--color-text-primary)">{L.squiggle.n3}</text>
      </g>
    </>
  )}

  {variant === 'hybrid' && (
    <g filter={`url(#${fid})`} opacity={W.alpha}>
      <path d="M86 112 C 60 100, 52 144, 76 162 C 102 181, 142 160, 136 134 C 131 112, 108 105, 86 112 Z" class="fill-[var(--color-pink)] sk-step1" opacity="0.35"/>

      {/* 1 — the process draws itself */}
      <path
        d="M30 168 C 4 130, 34 88, 74 102 C 114 116, 92 178, 52 170 C 12 162, 22 100, 62 86
           C 102 72, 132 128, 102 166 C 72 204, 28 176, 46 130 C 64 84, 130 88, 140 132
           C 150 176, 104 200, 88 170 C 72 140, 118 108, 158 124 C 198 140, 180 196, 146 191
           C 112 186, 130 132, 174 132 C 218 132, 226 182, 200 188 C 174 194, 186 146, 224 149
           C 258 152, 262 176, 248 178 C 234 180, 244 156, 272 158 C 292 160, 296 160, 306 159"
        stroke="var(--color-text-primary)" stroke-width={W.main} stroke-linecap="round" stroke-linejoin="round" class="sq-main"/>

      {/* 2 — it resolves at the junction */}
      <circle cx="312" cy="159" r={W.main + 3} class="fill-[var(--color-yellow)] sk-step2" stroke="var(--color-text-primary)" stroke-width={W.mid}/>

      {/* 3 — two branches reach out */}
      <path d="M318 150 C 336 130, 352 112, 372 104" stroke="var(--color-text-primary)" stroke-width={W.mid} stroke-linecap="round" class="sq-branch"/>
      <path d="M318 168 C 336 188, 352 206, 372 214" stroke="var(--color-text-primary)" stroke-width={W.mid} stroke-linecap="round" class="sq-branch"/>

      {/* 4 — only then do the artefacts appear */}
      <g class="sk-artifacts">
        <path d="M382 58 h116 v92 h-116 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
        <path d="M382 58 h116 v20 h-116 Z" class="fill-[var(--color-blue)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
        <circle cx="393" cy="68" r="3" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width={W.hair - 0.4}/>
        <circle cx="404" cy="68" r="3" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width={W.hair - 0.4}/>
        <path d="M392 88 h46 v26 h-46 Z" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
        <path d="M446 88 h42 v26 h-42 Z" class="fill-[var(--color-pink)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
        <path d="M392 126 h96 M392 137 h68" stroke="var(--color-text-primary)" stroke-width={W.hair} stroke-linecap="round" opacity="0.5"/>

        {outcome === 'metrics' && (
          <>
            <path d="M382 172 h116 v78 h-116 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
            <path d="M392 232 h16 v12 h-16 Z" class="fill-[var(--color-orange)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M416 220 h16 v24 h-16 Z" class="fill-[var(--color-orange)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M440 206 h16 v38 h-16 Z" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M464 192 h16 v52 h-16 Z" class="fill-[var(--color-blue)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M392 200 C 414 202, 434 188, 452 178 C 468 170, 478 186, 490 180" stroke="var(--color-accent)" stroke-width={W.mid} stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </>
        )}

        {outcome === 'system' && (
          <>
            <path d="M382 172 h116 v78 h-116 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
            <circle cx="400" cy="194" r="9" class="fill-[var(--color-pink)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <circle cx="424" cy="194" r="9" class="fill-[var(--color-orange)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <circle cx="448" cy="194" r="9" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <circle cx="472" cy="194" r="9" class="fill-[var(--color-blue)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M392 214 h46 v14 h-46 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M446 214 h42 v14 h-42 Z" class="fill-[var(--color-accent)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M392 238 h60 M460 238 h28" stroke="var(--color-text-primary)" stroke-width={W.hair} stroke-linecap="round" opacity="0.5"/>
          </>
        )}

        {outcome === 'surfaces' && (
          <>
            <path d="M382 176 h64 v70 h-64 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
            <path d="M382 176 h64 v12 h-64 Z" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
            <path d="M390 198 h48 M390 210 h34 M390 222 h44" stroke="var(--color-text-primary)" stroke-width={W.hair} stroke-linecap="round" opacity="0.5"/>
            <path d="M390 232 h26 v10 h-26 Z" class="fill-[var(--color-accent)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M460 172 h38 v78 h-38 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width={W.mid} rx="6"/>
            <path d="M472 179 h14" stroke="var(--color-text-primary)" stroke-width={W.hair} stroke-linecap="round"/>
            <path d="M466 190 h26 v18 h-26 Z" class="fill-[var(--color-pink)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
            <path d="M466 216 h26 M466 226 h18" stroke="var(--color-text-primary)" stroke-width={W.hair} stroke-linecap="round" opacity="0.5"/>
            <path d="M466 234 h26 v9 h-26 Z" class="fill-[var(--color-accent)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
          </>
        )}

        {outcome === 'people' && (
          <>
            <circle cx="404" cy="192" r="12" class="fill-[var(--color-pink)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
            <path d="M386 232 C 386 210, 422 210, 422 232" stroke="var(--color-text-primary)" stroke-width={W.mid} stroke-linecap="round" fill="none"/>
            <circle cx="442" cy="186" r="13" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
            <path d="M422 230 C 422 205, 462 205, 462 230" stroke="var(--color-text-primary)" stroke-width={W.mid} stroke-linecap="round" fill="none"/>
            <circle cx="478" cy="192" r="12" class="fill-[var(--color-blue)]" stroke="var(--color-text-primary)" stroke-width={W.mid}/>
            <path d="M460 232 C 460 210, 496 210, 496 232" stroke="var(--color-text-primary)" stroke-width={W.mid} stroke-linecap="round" fill="none"/>
            <path d="M436 160 C 430 150, 442 144, 448 152 C 454 144, 466 150, 460 160 C 456 167, 448 172, 448 172 C 448 172, 440 167, 436 160 Z" class="fill-[var(--color-orange)]" stroke="var(--color-text-primary)" stroke-width={W.hair}/>
          </>
        )}
      </g>

      {/* 5 — caption row last */}
      <g class="sk-caption">
        <path d="M52 258 C 106 268, 178 266, 248 256" stroke="var(--color-accent)" stroke-width={W.mid} stroke-linecap="round" opacity="0.5"/>
        <path d="M374 258 C 418 268, 468 266, 508 256" stroke="var(--color-accent)" stroke-width={W.mid} stroke-linecap="round" opacity="0.75"/>
        <text x="150" y="286" text-anchor="middle" class="sk-label" fill="var(--color-text-tertiary)">{L.hybrid.start}</text>
        <path d="M274 281 L 322 281 M313 275 L 324 281 L 313 287" stroke="var(--color-text-tertiary)" stroke-width={W.thin} stroke-linecap="round" stroke-linejoin="round" opacity="0.65" fill="none"/>
        <text x="442" y="286" text-anchor="middle" class="sk-label" fill="var(--color-text-tertiary)">{L.hybrid.end}</text>
      </g>
    </g>
  )}

  {variant === 'synthesis' && (
    <g filter={`url(#${fid})`}>
      {/* scattered notes */}
      <path d="M34 74 h58 v50 h-58 Z" class="fill-[var(--color-pink)]" stroke="var(--color-text-primary)" stroke-width="1.8" style="rotate:-8deg; transform-origin:63px 99px"/>
      <path d="M100 46 h58 v50 h-58 Z" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width="1.8" style="rotate:6deg; transform-origin:129px 71px"/>
      <path d="M52 148 h58 v50 h-58 Z" class="fill-[var(--color-blue)]" stroke="var(--color-text-primary)" stroke-width="1.8" style="rotate:4deg; transform-origin:81px 173px"/>
      <path d="M118 132 h58 v50 h-58 Z" class="fill-[var(--color-orange)]" stroke="var(--color-text-primary)" stroke-width="1.8" style="rotate:-5deg; transform-origin:147px 157px"/>
      <path d="M74 216 h58 v50 h-58 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width="1.8" style="rotate:9deg; transform-origin:103px 241px"/>
      {/* squiggly text lines on a couple of notes */}
      <path d="M44 92 h36 M44 102 h26" stroke="var(--color-text-primary)" stroke-width="1.5" stroke-linecap="round" opacity="0.45"/>
      <path d="M128 152 h36 M128 162 h22" stroke="var(--color-text-primary)" stroke-width="1.5" stroke-linecap="round" opacity="0.45"/>
      {/* sorting arrow */}
      <path d="M204 150 C 236 128, 250 176, 288 152" stroke="var(--color-text-primary)" stroke-width="2.4" stroke-linecap="round" class="squiggle"/>
      <path d="M274 141 L 292 151 L 275 163" stroke="var(--color-text-primary)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="squiggle-arrow"/>
      {/* tidy grid */}
      <path d="M320 84 h74 v46 h-74 Z" class="fill-[var(--color-pink)]" stroke="var(--color-text-primary)" stroke-width="1.8"/>
      <path d="M406 84 h74 v46 h-74 Z" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width="1.8"/>
      <path d="M320 144 h74 v46 h-74 Z" class="fill-[var(--color-orange)]" stroke="var(--color-text-primary)" stroke-width="1.8"/>
      <path d="M406 144 h74 v46 h-74 Z" class="fill-[var(--color-blue)]" stroke="var(--color-text-primary)" stroke-width="1.8"/>
      <path d="M332 102 h44 M332 112 h30" stroke="var(--color-text-primary)" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
      <path d="M418 102 h44 M418 112 h30" stroke="var(--color-text-primary)" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
      <path d="M332 162 h44 M332 172 h30" stroke="var(--color-text-primary)" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
      <path d="M418 162 h44 M418 172 h30" stroke="var(--color-text-primary)" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
      <path d="M320 212 C 372 222, 430 220, 480 210" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round" opacity="0.7"/>
      <text x="42" y="288" class="sk-label" fill="var(--color-text-tertiary)">{L.synthesis.start}</text>
      <text x="392" y="242" class="sk-label" fill="var(--color-text-tertiary)">{L.synthesis.end}</text>
    </g>
  )}

  {variant === 'craft' && (
    <g filter={`url(#${fid})`}>
      {/* rough wireframe */}
      <path d="M32 56 h190 v192 h-190 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width="2.2" style="rotate:-2deg; transform-origin:127px 152px"/>
      <g style="rotate:-2deg; transform-origin:127px 152px">
        <path d="M48 78 h58 v30 h-58 Z" stroke="var(--color-text-primary)" stroke-width="1.7" class="fill-[var(--color-pink)]" opacity="0.65"/>
        <path d="M118 82 h84 M118 94 h64" stroke="var(--color-text-primary)" stroke-width="1.7" stroke-linecap="round" opacity="0.55"/>
        <path d="M48 126 h154 M48 140 h132 M48 154 h96" stroke="var(--color-text-primary)" stroke-width="1.6" stroke-linecap="round" opacity="0.4"/>
        <path d="M48 176 h60 v22 h-60 Z" stroke="var(--color-text-primary)" stroke-width="1.7"/>
        <path d="M48 214 C 84 208, 120 220, 156 212" stroke="var(--color-text-primary)" stroke-width="1.6" stroke-linecap="round" opacity="0.35"/>
      </g>
      {/* arrow */}
      <path d="M242 150 C 258 138, 268 164, 286 152" stroke="var(--color-text-primary)" stroke-width="2.4" stroke-linecap="round" class="squiggle"/>
      <path d="M272 142 L 290 151 L 273 163" stroke="var(--color-text-primary)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="squiggle-arrow"/>
      {/* resolved interface */}
      <path d="M306 44 h182 v212 h-182 Z" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width="2.2"/>
      <path d="M306 44 h182 v30 h-182 Z" class="fill-[var(--color-blue)]" stroke="var(--color-text-primary)" stroke-width="2.2"/>
      <circle cx="320" cy="59" r="4" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width="1.4"/>
      <circle cx="334" cy="59" r="4" class="fill-[var(--color-surface)]" stroke="var(--color-text-primary)" stroke-width="1.4"/>
      <path d="M322 90 h66 v42 h-66 Z" class="fill-[var(--color-yellow)]" stroke="var(--color-text-primary)" stroke-width="1.7"/>
      <path d="M400 90 h72 v42 h-72 Z" class="fill-[var(--color-pink)]" stroke="var(--color-text-primary)" stroke-width="1.7"/>
      <path d="M322 148 h150 M322 162 h124 M322 176 h96" stroke="var(--color-text-primary)" stroke-width="1.7" stroke-linecap="round" opacity="0.5"/>
      <path d="M322 200 h74 v26 h-74 Z" class="fill-[var(--color-accent)]" stroke="var(--color-text-primary)" stroke-width="1.7"/>
      <path d="M312 272 C 358 280, 434 278, 484 268" stroke="var(--color-accent)" stroke-width="2.2" stroke-linecap="round" opacity="0.7"/>
      <text x="40" y="286" class="sk-label" fill="var(--color-text-tertiary)">{L.craft.start}</text>
      <text x="398" y="292" class="sk-label" fill="var(--color-text-tertiary)">{L.craft.end}</text>
    </g>
  )}

  {variant === 'system' && (
    <g filter={`url(#${fid})`}>
      {/* connections drawn first so nodes sit on top */}
      <path d="M104 96 C 158 78, 208 88, 246 108" stroke="var(--color-text-primary)" stroke-width="2.1" stroke-linecap="round" class="squiggle"/>
      <path d="M246 132 C 210 168, 152 172, 112 158" stroke="var(--color-text-primary)" stroke-width="2.1" stroke-linecap="round" class="squiggle"/>
      <path d="M296 118 C 344 106, 386 118, 412 96" stroke="var(--color-text-primary)" stroke-width="2.1" stroke-linecap="round" class="squiggle"/>
      <path d="M296 136 C 342 158, 380 176, 414 196" stroke="var(--color-text-primary)" stroke-width="2.1" stroke-linecap="round" class="squiggle"/>
      <path d="M112 178 C 172 216, 268 228, 388 212" stroke="var(--color-text-primary)" stroke-width="2.1" stroke-linecap="round" stroke-dasharray="6 8" opacity="0.55"/>
