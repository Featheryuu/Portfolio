<section class="relative overflow-hidden bg-gradient-soft min-h-[92vh] flex items-center">
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 relative w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    {/* Text column */}
    <div class="lg:col-span-7">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-surface border border-border rounded-full mb-8 animate-fade-in-up shadow-sm">
        <span class="relative flex w-2 h-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75 animate-ping"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
        </span>
        <span class="text-xs font-medium text-text-secondary">Available for new projects</span>
      </div>

      <p class="text-xs font-medium text-accent tracking-[0.18em] uppercase mb-5 animate-fade-in-up flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        Product Designer
      </p>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary leading-[1.05] mb-6 animate-fade-in-up animation-delay-100 tracking-tight">
        Hi, I'm <span class="relative inline-block">
          <span class="relative z-10">Chia-Ying</span>
          <span class="absolute bottom-1 left-0 w-full h-3 bg-orange -z-0" aria-hidden="true"></span>
        </span><br/>
        I design{' '}
        <span class="relative inline-block" data-rotate-keyword-c aria-hidden="true">
          <span class="relative z-10 text-accent">experiences</span>
          <span class="absolute bottom-1 left-0 w-full h-3 bg-yellow -z-0"></span>
        </span>
        <span class="sr-only">experiences, products, systems, and interfaces</span>
      </h1>

      <p class="text-lg text-text-secondary max-w-xl leading-relaxed mb-10 animate-fade-in-up animation-delay-200">
        A full-stack product designer who solves real user problems and delivers measurable business outcomes. I advocate for inclusive design and create accessible, human-centered experiences.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up animation-delay-300">
        <a
          href="#work"
          class="group inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-accent text-surface rounded-full font-medium text-sm hover:bg-accent-hover transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5"
        >
          View my work
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
        <a
          href="#contact"
          class="group inline-flex items-center justify-center px-8 py-3.5 border-2 border-text-primary/50 rounded-full font-medium text-sm text-text-primary hover:border-text-primary hover:bg-orange transition-all duration-300"
        >
          Get in touch
        </a>
      </div>
    </div>

    {/* Visual column — stacked sample tiles (teaser for work) */}
    <div class="hidden lg:block lg:col-span-5 animate-fade-in-up animation-delay-400">
      <div class="relative h-[28rem]">
        {/* Back tile — pink */}
        <div class="absolute top-0 left-8 w-56 h-72 rounded-2xl bg-pink border border-border shadow-md transform -rotate-6 flex flex-col justify-end p-5">
          <p class="text-xs font-medium text-text-tertiary tracking-widest uppercase">Enterprise</p>
          <p class="text-sm font-semibold text-text-primary mt-1">My Heathrow</p>
        </div>
        {/* Middle tile — yellow */}
        <div class="absolute top-10 left-24 w-56 h-72 rounded-2xl bg-yellow border border-border shadow-lg transform rotate-3 flex flex-col justify-end p-5">
          <p class="text-xs font-medium text-text-tertiary tracking-widest uppercase">Service</p>
          <p class="text-sm font-semibold text-text-primary mt-1">Kinship</p>
        </div>
        {/* Front tile — blue */}
        <div class="absolute top-20 left-40 w-56 h-72 rounded-2xl bg-blue border border-border shadow-xl transform -rotate-2 flex flex-col justify-end p-5">
          <p class="text-xs font-medium text-text-tertiary tracking-widest uppercase">Retail</p>
          <p class="text-sm font-semibold text-text-primary mt-1">Cornershop</p>
        </div>
        {/* Floating dot accent */}
        <div class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-accent"></div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const words = ['experiences', 'products', 'systems', 'interfaces'];
    const el = document.querySelector<HTMLElement>('[data-rotate-keyword-c] span.relative');
    const headline = document.querySelector<HTMLElement>('h1');
    if (el) {
      let i = 0;
      let paused = false;
      const tick = () => {
        if (paused) return;
        i = (i + 1) % words.length;
        el.style.transition = 'opacity 0.3s, transform 0.3s';
        el.style.opacity = '0';
        el.style.transform = 'translateY(-8px)';
        setTimeout(() => {
          el.textContent = words[i];
          el.style.transform = 'translateY(8px)';
          requestAnimationFrame(() => {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          });
        }, 300);
      };
      setInterval(tick, 2400);
      headline?.addEventListener('mouseenter', () => { paused = true; });
      headline?.addEventListener('mouseleave', () => { paused = false; });
    }
  }
</script>
