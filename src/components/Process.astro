---
const steps = [
  {
    number: '01',
    title: 'Define',
    description: 'Understand the problem space, stakeholder goals, and user needs through research and analysis.',
    surface: 'bg-pink',
    dot: 'bg-orange',
    tags: ['Stakeholder interviews', 'Problem framing', 'Success metrics'],
    visual: 'define',
  },
  {
    number: '02',
    title: 'Discover',
    description: 'Explore opportunities through user research, competitive analysis, and collaborative workshops.',
    surface: 'bg-orange',
    dot: 'bg-yellow',
    tags: ['User interviews', 'Journey maps', 'Synthesis'],
    visual: 'discover',
  },
  {
    number: '03',
    title: 'Develop',
    description: 'Create solutions through iterative prototyping, testing, and design system thinking.',
    surface: 'bg-yellow',
    dot: 'bg-pink',
    tags: ['Wireframes', 'Hi-fi designs', 'Usability testing', 'Vibe coding'],
    visual: 'develop',
  },
  {
    number: '04',
    title: 'Deliver',
    description: 'Ship polished designs with clear documentation, handoff specs, and measurable outcomes.',
    surface: 'bg-blue',
    dot: 'bg-accent',
    tags: ['Design system', 'Dev handoff', 'QA review'],
    visual: 'deliver',
  },
];
---

<section id="process" class="py-20 md:py-28 bg-gradient-softer relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 relative">
    <div class="reveal max-w-2xl mb-16">
      <p class="text-xs font-medium text-accent uppercase tracking-[0.18em] mb-3 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-accent"></span>
        Process
      </p>
      <h2 class="text-3xl md:text-4xl font-semibold text-text-primary mb-4">
        How I work
      </h2>
      <p class="text-text-secondary text-lg">
        A structured yet flexible approach that adapts to the needs of each project — from research to delivery.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map((step, i) => (
        <div class="reveal" style={`transition-delay: ${i * 100}ms`}>
          <article
            tabindex="0"
            aria-label={`Step ${step.number}: ${step.title}`}
            class={`h-full rounded-2xl border border-border ${step.surface} p-6 flex flex-col transition-all duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/5 focus-visible:-translate-y-1 focus-visible:shadow-xl focus-visible:shadow-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary`}>
            {/* Visual per stage */}
            <div class="aspect-[4/3] rounded-xl bg-surface/70 border border-border mb-5 flex items-center justify-center overflow-hidden relative">
              {step.visual === 'define' && (
                <svg class="w-24 h-24 text-text-primary" viewBox="0 0 96 96" fill="none" aria-hidden="true">
                  <rect x="14" y="22" width="68" height="52" rx="6" stroke="currentColor" stroke-width="2"/>
                  <line x1="24" y1="36" x2="62" y2="36" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="24" y1="46" x2="72" y2="46" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="24" y1="56" x2="52" y2="56" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <circle cx="72" cy="28" r="6" fill="currentColor"/>
                </svg>
              )}
              {step.visual === 'discover' && (
                <svg class="w-24 h-24 text-text-primary" viewBox="0 0 96 96" fill="none" aria-hidden="true">
                  <circle cx="42" cy="42" r="22" stroke="currentColor" stroke-width="2"/>
                  <line x1="58" y1="58" x2="76" y2="76" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                  <circle cx="36" cy="38" r="2.5" fill="currentColor"/>
                  <circle cx="48" cy="38" r="2.5" fill="currentColor"/>
                  <path d="M34 48 Q42 54 50 48" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                </svg>
              )}
              {step.visual === 'develop' && (
                <svg class="w-24 h-24 text-text-primary" viewBox="0 0 96 96" fill="none" aria-hidden="true">
                  <rect x="14" y="16" width="42" height="56" rx="4" stroke="currentColor" stroke-width="2"/>
                  <rect x="44" y="28" width="38" height="52" rx="4" fill="var(--color-surface)" stroke="currentColor" stroke-width="2"/>
                  <line x1="52" y1="42" x2="74" y2="42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <line x1="52" y1="52" x2="68" y2="52" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <circle cx="56" cy="66" r="4" fill="currentColor"/>
                </svg>
              )}
              {step.visual === 'deliver' && (
                <svg class="w-24 h-24 text-text-primary" viewBox="0 0 96 96" fill="none" aria-hidden="true">
                  <path d="M20 48 L40 68 L78 28" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="48" cy="48" r="36" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.5"/>
                </svg>
              )}
            </div>

            <p class="text-xs font-semibold text-text-tertiary tracking-widest mb-2">{step.number}</p>
            <h3 class="text-xl font-semibold text-text-primary mb-2">{step.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-4 flex-1">{step.description}</p>

            <ul class="space-y-1.5">
              {step.tags.map((tag) => (
                <li class="text-xs text-text-primary flex items-center gap-2">
                  <span class={`w-1.5 h-1.5 rounded-full ${step.dot} ring-1 ring-text-primary/10`}></span>
                  {tag}
                </li>
              ))}
            </ul>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
