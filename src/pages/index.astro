---
import BaseLayout from '../layouts/BaseLayout.astro';
// Hero variants: Hero (blurred blobs), HeroB (Bauhaus geometric), HeroC (split tiles teaser)
import Hero from '../components/HeroB.astro';
import ValueProp from '../components/ValueProp.astro';
import WorkB from '../components/WorkB.astro';
import WorkC from '../components/WorkC.astro';
import WorkD from '../components/WorkD.astro';
import WorkE from '../components/WorkE.astro';
import WorkF from '../components/WorkF.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Process from '../components/Process.astro';
import ProcessB from '../components/ProcessB.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import Skills from '../components/Skills.astro';

const projects = [
  {
    title: 'My Heathrow',
    description: 'Consolidating multiple airport services into a unified digital platform, improving passenger experience and driving loyalty programme engagement.',
    tags: ['Enterprise', 'UX Research', 'Design System'],
    href: '/work/my-heathrow',
    image: '/images/work/my-heathrow/hero.jpg',
    imageAlt: 'My Heathrow airport services platform showing the unified dashboard with flight information, rewards, and offers',
    surface: 'pink' as const,
  },
  {
    title: 'Kinship',
    description: 'Designing a care support platform that connects carers with guidance, resources, and community — making support more accessible.',
    tags: ['Product Design', 'Accessibility', 'Mobile'],
    href: '/work/kinship',
    image: '/images/work/kinship/hero.jpg',
    imageAlt: 'Kinship Connect — a guided sentence-builder form for kinship carers alongside the Grandparents Plus site with the Kinship Connect widget open',
    surface: 'orange' as const,
    imageBg: '#FEEECA',
  },
  {
    title: 'Cornershop',
    description: 'Building an operations dashboard that improved retail visibility and created a more efficient, data-driven management experience.',
    tags: ['Dashboard', 'Data Viz', 'E-commerce'],
    href: '/work/cornershop',
    image: '/images/work/cornershop/hero.jpg',
    imageAlt: 'Cornershop retail operations dashboard displaying store analytics and inventory management',
    surface: 'blue' as const,
  },
];
---

<BaseLayout title="Chia-Ying Tsai — Product Designer">
  <Hero />
  <ValueProp />
  <WorkF />

  {/* Selected Work variants: <WorkB /> grid+filters, <WorkC /> stacked deck, <WorkD /> bento, <WorkE /> fanned cards, <WorkF /> equal 3-up D-style */}
  <section id="work-old" class="py-20 md:py-28 hidden">
    <div class="max-w-6xl mx-auto px-6">
      <div class="reveal max-w-2xl mb-16">
        <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-accent"></span>
          Selected work
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold text-text-primary mb-4">
          Recent case studies
        </h2>
        <p class="text-text-secondary text-lg">
          Enterprise and product design work — focused on real impact for users and business.
        </p>
      </div>

      <div class="space-y-20 md:space-y-28">
        {projects.map((project, i) => {
          const surfaceMap = { pink: 'bg-pink', orange: 'bg-orange', yellow: 'bg-yellow', blue: 'bg-blue' };
          const surfaceClass = surfaceMap[project.surface];
          const reversed = i % 2 === 1;
          const number = String(i + 1).padStart(2, '0');
          return (
            <a href={project.href} class="reveal group block">
              <div class={`grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center ${reversed ? 'md:[&>*:first-child]:order-2' : ''}`}>
                <div class="md:col-span-7">
                  <div
                    class={`relative overflow-hidden rounded-2xl border border-border ${project.imageBg ? '' : surfaceClass} aspect-[16/10] transition-all duration-500 group-hover:shadow-2xl group-hover:shadow-black/10 group-hover:-translate-y-1`}
                    style={project.imageBg ? `background-color: ${project.imageBg}` : undefined}
                  >
                    <img src={project.image} alt={project.imageAlt} class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" loading="lazy" />
                  </div>
                </div>
                <div class="md:col-span-5">
                  <p class="text-xs font-medium text-text-tertiary tracking-[0.2em] uppercase mb-3">Project {number}</p>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {project.tags.map((tag) => (
                      <span class={`text-xs font-medium text-text-primary ${surfaceClass} px-3 py-1 rounded-full`}>{tag}</span>
                    ))}
                  </div>
                  <h3 class="text-2xl md:text-3xl font-semibold text-text-primary mb-4 group-hover:text-accent transition-colors">
                    {project.title}
                  </h3>
                  <p class="text-text-secondary leading-relaxed mb-6">{project.description}</p>
                  <span
                    role="button"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent text-surface rounded-full font-medium text-sm shadow-sm transition-all duration-300 group-hover:bg-accent-hover group-hover:shadow-lg group-hover:-translate-y-0.5"
                  >
                    View case study
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <ProcessB />
  <About />
  <Testimonials />
  <Skills />
</BaseLayout>
