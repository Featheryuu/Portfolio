---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  role: string;
  client: string;
  year: string;
  team?: string;
  heroImage: string;
  heroImageAlt: string;
  surface?: 'pink' | 'orange' | 'yellow' | 'blue';
  prevProject?: { title: string; href: string };
  nextProject?: { title: string; href: string };
  projectIndex?: number;
  projectTotal?: number;
  lang?: 'en' | 'zh';
}

const props = Astro.props.frontmatter || Astro.props;
const {
  title,
  description,
  role,
  client,
  year,
  team,
  heroImage,
  heroImageAlt,
  surface = 'pink',
  prevProject,
  nextProject,
  projectIndex,
  projectTotal,
  lang = 'en',
} = props;

const surfaceClass = {
  pink: 'bg-pink',
  orange: 'bg-orange',
  yellow: 'bg-yellow',
  blue: 'bg-blue',
}[surface];

const ui = lang === 'zh'
  ? { back: '返回作品', backHref: '/zh/#work', project: '專案', client: '客戶', role: '角色', year: '年份', team: '團隊' }
  : { back: 'Back to work', backHref: '/#work', project: 'Project', client: 'Client', role: 'Role', year: 'Year', team: 'Team' };
---

<BaseLayout title={`${title} — Chia-Ying Tsai`} description={description} lang={lang}>
  {/* Back navigation */}
  <div class="max-w-4xl mx-auto px-6 pt-8">
    <a
      href={ui.backHref}
      class="inline-flex items-center gap-1 text-sm text-text-tertiary hover:text-text-primary transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      {ui.back}
    </a>
  </div>

  {/* Hero */}
  <header class="max-w-4xl mx-auto px-6 pt-8 pb-12">
    {projectIndex && projectTotal && (
      <p class="text-xs font-medium text-text-tertiary tracking-[0.18em] uppercase mb-4 animate-fade-in-up">
        {ui.project} <span class="text-accent">{String(projectIndex).padStart(2, '0')}</span>
        <span class="mx-1">/</span>
        {String(projectTotal).padStart(2, '0')}
      </p>
    )}
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary mb-4 animate-fade-in-up">
      {title}
    </h1>
    <p class="text-lg text-text-secondary max-w-2xl mb-8 animate-fade-in-up animation-delay-100">
      {description}
    </p>

    {/* Metadata */}
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-6 border-y border-border animate-fade-in-up animation-delay-200">
      <div>
        <p class="text-xs font-medium text-text-tertiary uppercase tracking-wider mb-1 flex items-center gap-1.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5"/>
          </svg>
          {ui.client}
        </p>
        <p class="text-sm font-medium text-text-primary">{client}</p>
      </div>
      <div>
        <p class="text-xs font-medium text-text-tertiary uppercase tracking-wider mb-1 flex items-center gap-1.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          {ui.role}
        </p>
        <p class="text-sm font-medium text-text-primary">{role}</p>
      </div>
      <div>
        <p class="text-xs font-medium text-text-tertiary uppercase tracking-wider mb-1 flex items-center gap-1.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {ui.year}
        </p>
        <p class="text-sm font-medium text-text-primary">{year}</p>
      </div>
      {team && (
        <div>
          <p class="text-xs font-medium text-text-tertiary uppercase tracking-wider mb-1 flex items-center gap-1.5">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            {ui.team}
          </p>
          <p class="text-sm font-medium text-text-primary">{team}</p>
        </div>
      )}
    </div>
  </header>

  {/* Hero image */}
  <div class="max-w-5xl mx-auto px-6 mb-16">
    <div class={`rounded-xl overflow-hidden ${surfaceClass} border border-border aspect-[16/9]`}>
      <img
        src={heroImage}
        alt={heroImageAlt}
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  {/* MDX content */}
  <article class="max-w-4xl mx-auto px-6 pb-20 prose-custom">
    <slot />
  </article>

  {/* Lightbox for zoomable images */}
  <div
    id="lightbox"
    class="lightbox"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    inert
  >
    <img id="lightbox-img" src="" alt="" />
    <button
      id="lightbox-close"
      type="button"
      aria-label="Close image"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6"/>
      </svg>
    </button>
  </div>

  <script is:inline>
    (() => {
      const lb = document.getElementById('lightbox');
      const lbImg = document.getElementById('lightbox-img');
      const closeBtn = document.getElementById('lightbox-close');
      if (!lb || !lbImg || !closeBtn) return;

      let lastFocused = null;

      const open = (src, alt) => {
        lastFocused = document.activeElement;
        lbImg.src = src;
        lbImg.alt = alt || '';
        lb.classList.add('is-open');
        lb.removeAttribute('inert');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        closeBtn.focus();
      };
      const close = () => {
        lb.classList.remove('is-open');
        lb.setAttribute('inert', '');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      };

      // Wrap each zoomable image in a <button> so it's keyboard-reachable
      document.querySelectorAll('img[data-zoomable]').forEach((img) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'zoomable-trigger';
        btn.setAttribute('aria-label', `Enlarge image: ${img.alt || 'image'}`);
        img.parentNode.insertBefore(btn, img);
        btn.appendChild(img);
        btn.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
      });

      // Close when clicking the dialog backdrop (not the image itself)
      lb.addEventListener('click', (e) => {
        if (e.target === lb) close();
      });
      closeBtn.addEventListener('click', close);

      // Focus trap: only one focusable control, keep focus on it
      lb.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          e.preventDefault();
          closeBtn.focus();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lb.classList.contains('is-open')) close();
      });
    })();
  </script>

  <script is:inline>
    // Make every content card (impact stats, process steps, figures) keyboard-focusable
    // so users can tab through each section rather than skipping title → page nav.
    (() => {
      const article = document.querySelector('article.prose-custom');
      if (!article) return;

      // Section landmarks only — h2 gives keyboard users one tab stop per section
      // without flooding the tab order with individual cards, figures, or subheadings.
      article.querySelectorAll('h2').forEach((h) => {
        if (!h.hasAttribute('tabindex')) h.setAttribute('tabindex', '0');
      });
    })();
  </script>

  {/* Project navigation */}
  <nav class="max-w-4xl mx-auto px-6 pb-20" aria-label="Project navigation">
    <div class="flex flex-col sm:flex-row justify-between gap-4 pt-8 border-t border-border">
      {prevProject ? (
        <a
          href={prevProject.href}
          class="group flex items-center gap-2 text-text-secondary hover:text-text-primary transition-colors"
        >
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          <span class="text-sm">{prevProject.title}</span>
        </a>
      ) : <div />}
      {nextProject ? (
        <a
          href={nextProject.href}
          class="group flex items-center gap-2 text-text-secondary hover:text-text-primary transition-colors sm:ml-auto"
        >
          <span class="text-sm">{nextProject.title}</span>
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      ) : <div />}
    </div>
  </nav>
</BaseLayout>

<style is:global>
  /* Case study content styling */
  .prose-custom h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }

  .prose-custom h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }

  .prose-custom p {
    margin-bottom: 1.25rem;
    max-width: 75ch;
  }

  .prose-custom ul,
  .prose-custom ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose-custom li {
    margin-bottom: 0.5rem;
  }

  .prose-custom ul li {
    list-style-type: disc;
  }

  .prose-custom ol li {
    list-style-type: decimal;
  }

  .prose-custom img {
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    margin: 2rem 0;
    max-width: 100%;
    height: auto;
  }

  /* Images inside figures or not-prose wrappers already have their own
     framing (border, rounded corners, background). Strip the prose-level
     margin/border so no white gap appears between the image and its frame. */
  .prose-custom figure,
  .prose-custom .not-prose figure {
    margin: 0;
  }
  .prose-custom figure img,
  .prose-custom .not-prose img {
    margin: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    display: block;
    width: 100%;
  }
  .prose-custom figure figcaption {
    margin-top: 0;
  }

  .prose-custom blockquote {
    border-left: 3px solid var(--color-border);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  .prose-custom strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .prose-custom h2:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Zoomable image trigger — wraps <img data-zoomable> */
  .zoomable-trigger {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    background: transparent;
    border: 0;
    cursor: zoom-in;
    border-radius: 0.75rem;
  }
  .zoomable-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .zoomable-trigger {
    position: relative;
    overflow: hidden;
  }
  .zoomable-trigger img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    transition: transform 0.4s ease;
  }
  .zoomable-trigger:hover img,
  .zoomable-trigger:focus-visible img {
    transform: scale(1.01);
  }
  /* Corner zoom-in icon — fades in on hover/focus to signal the lightbox. */
  .zoomable-trigger::after {
    content: "";
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: rgba(17, 17, 17, 0.72);
    /* zoom-in magnifier glyph */
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='7'/><line x1='21' y1='21' x2='16.65' y2='16.65'/><line x1='11' y1='8' x2='11' y2='14'/><line x1='8' y1='11' x2='14' y2='11'/></svg>");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 1rem 1rem;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }
  .zoomable-trigger:hover::after,
  .zoomable-trigger:focus-visible::after {
    opacity: 1;
    transform: translateY(0);
  }

  /* Lightbox for zoomable images */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.92);
    cursor: zoom-out;
  }
  .lightbox.is-open {
    display: flex;
  }
  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 0.5rem;
  }
  .lightbox button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .lightbox button:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .lightbox button svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  @media (min-width: 768px) {
    .lightbox { padding: 2.5rem; }
  }
</style>
